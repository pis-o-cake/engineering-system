#!/bin/sh

# Engineering System push gate. `engsys init --hooks` writes this file and points
# core.hooksPath at it. Edit it in the project; the standard does not overwrite it.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

# A missing launcher means the developer has not activated the standard. Report it and let
# the push through: a gate that blocks work it cannot explain gets deleted, not fixed.
if ! command -v engsys >/dev/null 2>&1; then
  printf 'pre-push: engsys is not on PATH; Engineering System checks did not run\n' >&2
  printf 'pre-push: run install.sh in the system checkout, then engsys doctor\n' >&2
  exit 0
fi

refs=$(mktemp)
trap 'rm -f "$refs"' 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15
cat >"$refs"

# 표준을 아직 올리지 않은 engsys 에는 이 subcommand 가 없다. 그 경우 건너뛴다.
if engsys vcs --help >/dev/null 2>&1; then
  engsys vcs check-branch --project "$root"
fi

engsys verify --project "$root"

# 검토 기록은 실제 전송할 commit에 있어야 한다. working tree의 기록으로 대신하지 않는다.
if grep -q '^  review:' .engsys/project.yaml; then
  while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in ''|*[!0]*) ;; *) continue ;; esac
    engsys review check --project "$root" --revision "$local_oid"
  done <"$refs"
fi
