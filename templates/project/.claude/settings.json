{
  "extraKnownMarketplaces": {
    "__MARKETPLACE__": {
      "source": {
        "source": "github",
        "repo": "__REPO__"
      }
    }
  },
  "enabledPlugins": {
    "engsys@__MARKETPLACE__": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "engsys vcs merge-request-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
