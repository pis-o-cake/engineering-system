{
  "description": "Block Claude from directly editing generated documentation declared by a project contract.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/packages/docs-gov/claude-code/hooks/block-generated-edit.sh\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
