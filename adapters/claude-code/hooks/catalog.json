{
  "description": "Documentation guardrails contributed by the docs-gov package.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/packages/docs-gov/claude-code/hooks/block-generated-edit.sh\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/packages/docs-gov/claude-code/hooks/check-document-structure.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/packages/docs-gov/claude-code/hooks/session-status.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
