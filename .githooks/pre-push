#!/bin/sh

# CI runner가 준비되기 전까지의 hard gate. push 전에 이 레포의 native 검사를 강제한다.
# 활성화(1회): git config core.hooksPath .githooks
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"
refs=$(mktemp)
trap 'rm -f "$refs"' 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15
cat >"$refs"
sh tests/test-all.sh

# 검토 기록은 실제 전송할 commit에 있어야 한다. working tree의 기록으로 대신하지 않는다.
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in ''|*[!0]*) ;; *) continue ;; esac
  bin/engsys review check --project "$root" --revision "$local_oid" --scope docs --scope README.md
done <"$refs"
