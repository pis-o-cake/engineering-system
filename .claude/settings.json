{
  "extraKnownMarketplaces": {
    "engineering-system": {
      "source": {
        "source": "github",
        "repo": "pis-o-cake/engineering-system"
      }
    }
  },
  "enabledPlugins": {
    "engsys@engineering-system": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "engsys vcs merge-request-hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
