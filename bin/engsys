#!/bin/sh

# Dependency-free project adapter for the Engineering System plugin.
set -eu

if [ -n "${ENGSYS_SYSTEM_ROOT:-}" ]; then
  system_root=$(CDPATH= cd -- "$ENGSYS_SYSTEM_ROOT" && pwd)
else
  system_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
fi

die() {
  printf '%s\n' "engsys: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  engsys init [--detect | --verify <command>] [options]
  engsys check [--project <directory>] [--revision <commit>]
  engsys setup [--project <directory>] [--yes]
  engsys doctor [--project <directory>]
  engsys hooks <status|update> [--project <directory>] [--force] [--adopt]
  engsys sync [--project <directory>]
  engsys verify [--project <directory>] [--revision <commit>]
  engsys review <status|record|check> [options]
  engsys docs check [--project <directory>] [--path <document>]
  engsys docs new --type <type> <slug> [--project <directory>] [--path <directory>]
  engsys vcs check-message <file> [--project <directory>]
  engsys vcs check-branch [--project <directory>] [--branch <name>]
  engsys vcs <base-branch|check-settings|settings> [--project <directory>] [--branch <name>]
  engsys upgrade [--project <directory>] [--apply]
  engsys resolve [--project <directory>]
  engsys claude [--project <directory>] [claude arguments...]
  engsys shellenv

Options for init:
  --project <directory>       Target Git worktree (default: current directory)
  --detect                    Fill unset declarations by inspecting the project
  --dry-run                   Show what init would write and change nothing
  --hooks                     Write .githooks/pre-push and point core.hooksPath at it
  --name <name>               Project name (default: directory name)
  --profile <profile>         System profile (default: baseline)
  --verify <command>          Project-native verification command (required)
  --source <name=path>        Source-of-truth path; repeatable
  --policy <path>             Documentation policy path
  --architecture <path>       Current architecture document path
  --generated <path> <command>
                              Generated document output and its check command; repeatable
  --lifecycle <name> <path> <statuses>
                              Historical record path and comma-separated frozen statuses; repeatable
EOF
}

yaml_quote() {
  printf "'%s'" "$(printf %s "$1" | sed "s/'/''/g")"
}

yaml_unquote() {
  value=$1
  case "$value" in
    \'*\') value=${value#\'}; value=${value%\'}; value=$(printf %s "$value" | sed "s/''/'/g") ;;
  esac
  printf %s "$value"
}

require_value() {
  [ "$#" -ge 2 ] || die "$1 requires a value"
}

normalise_project_dir() {
  [ -d "$1" ] || die "project directory does not exist: $1"
  (CDPATH= cd -- "$1" && pwd)
}

require_worktree() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "target is not a Git worktree: $1"
}

require_profile() {
  require_profile_name "$1"
  [ -f "$system_root/profiles/$1.yaml" ] || die "unknown profile: $1"
}

require_profile_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_-]*) die "invalid profile name: $1" ;;
  esac
}

require_relative_path() {
  case "$1" in
    ''|/*|..|../*|*/../*|*/..) die "path must be project-relative: $1" ;;
  esac
}

profile_packages() {
  awk '
    /^packages:$/ { in_packages = 1; next }
    /^[A-Za-z]/ { in_packages = 0 }
    in_packages && /^  - / { sub(/^  -[ \t]*/, ""); print }
  ' "$system_root/profiles/$1.yaml"
}

package_version() {
  sed -n 's/^  version:[[:space:]]*//p' "$system_root/packages/$1/package.yaml" | sed -n '1p'
}

system_revision() {
  git -C "$system_root" rev-parse HEAD 2>/dev/null || printf '%s' 'unversioned'
}

system_is_clean() {
  [ -z "$(git -C "$system_root" status --porcelain --untracked-files=no 2>/dev/null)" ]
}

cache_root() {
  if [ -n "${ENGSYS_CACHE_DIR:-}" ]; then
    printf '%s' "$ENGSYS_CACHE_DIR"
  elif [ -n "${XDG_CACHE_HOME:-}" ]; then
    printf '%s/engineering-system' "$XDG_CACHE_HOME"
  else
    printf '%s/.cache/engineering-system' "$HOME"
  fi
}

require_safe_revision() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) die "unsupported lock revision: $1" ;;
  esac
}

project_profile() {
  profile=$(sed -n 's/^  profile:[[:space:]]*//p' "$1" | sed -n '1p')
  yaml_unquote "$profile"
}

lock_package_names() {
  awk '
    /^packages:$/ { in_packages = 1; next }
    in_packages && /^  [A-Za-z0-9_-]+:$/ {
      name = $0
      sub(/^  /, "", name)
      sub(/:$/, "", name)
      print name
    }
  ' "$1"
}

lock_package_value() {
  lock=$1
  package=$2
  key=$3
  value=$(awk -v package="$package" -v key="$key" '
    $0 == "  " package ":" { in_package = 1; next }
    in_package && /^  [A-Za-z0-9_-]+:$/ { exit }
    in_package && $0 ~ "^    " key ":[[:space:]]*" {
      sub("^    " key ":[[:space:]]*", "")
      print
      exit
    }
  ' "$lock")
  yaml_unquote "$value"
}

lock_system_revision() {
  revision=$(sed -n '/^system:$/,/^profile:$/s/^  revision:[[:space:]]*//p' "$1" | sed -n '1p')
  yaml_unquote "$revision"
}

require_plugin_relative_path() {
  case "$1" in
    ''|/*|..|../*|*/../*|*/..) die "path must be plugin-relative: $1" ;;
  esac
}

package_adapter_skills() {
  source_root=$1
  package=$2
  manifest="$source_root/packages/$package/package.yaml"
  [ -f "$manifest" ] || die "package is missing from locked system revision: $package"

  awk '
    /^  claude-code:$/ { in_adapter = 1; in_skills = 0; next }
    in_adapter && /^  [A-Za-z0-9_-]+:$/ { exit }
    in_adapter && /^    skills:$/ { in_skills = 1; next }
    in_skills && /^    [A-Za-z0-9_-]+:$/ { exit }
    in_skills && /^      - / {
      sub(/^      -[[:space:]]*/, "")
      print
    }
  ' "$manifest"
}

package_adapter_hooks() {
  source_root=$1
  package=$2
  manifest="$source_root/packages/$package/package.yaml"
  [ -f "$manifest" ] || die "package is missing from locked system revision: $package"

  awk '
    function emit() {
      # IFS 로 TAB 을 쓰면 빈 field 가 사라진다. matcher 없는 event 는 '-' 로 표시해 실어 보낸다.
      if (event != "") print event "\t" (matcher == "" ? "-" : matcher) "\t" command "\t" timeout
      event = matcher = command = timeout = ""
    }
    /^  claude-code:$/ { in_adapter = 1; in_hooks = 0; next }
    in_adapter && /^  [A-Za-z0-9_-]+:$/ { in_adapter = 0; in_hooks = 0; next }
    in_adapter && /^    hooks:$/ { in_hooks = 1; next }
    in_hooks && /^    [A-Za-z0-9_-]+:$/ { in_hooks = 0; next }
    in_hooks && /^      - event:[[:space:]]*/ {
      emit()
      event = $0
      sub(/^      - event:[[:space:]]*/, "", event)
      next
    }
    in_hooks && /^        matcher:[[:space:]]*/ {
      matcher = $0
      sub(/^        matcher:[[:space:]]*/, "", matcher)
      next
    }
    in_hooks && /^        command:[[:space:]]*/ {
      command = $0
      sub(/^        command:[[:space:]]*/, "", command)
      next
    }
    in_hooks && /^        timeout:[[:space:]]*/ {
      timeout = $0
      sub(/^        timeout:[[:space:]]*/, "", timeout)
      next
    }
    END { emit() }
  ' "$manifest"
}

source_plugin_version() {
  sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$1/.claude-plugin/plugin.json" | sed -n '1p'
}

write_plugin_manifest() {
  source_root=$1
  packages=$2
  destination=$3
  version=$(source_plugin_version "$source_root")
  [ -n "$version" ] || die "plugin manifest has no version"

  {
    cat <<EOF
{
  "\$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "engsys",
  "displayName": "Engineering System",
  "version": "$version",
  "description": "Lock-aware Engineering System workflows.",
  "author": { "name": "pis-o-cake" },
  "repository": "https://github.com/pis-o-cake/engineering-system",
  "skills": [
EOF
    first=true
    for package in $packages; do
      skill_paths=$(package_adapter_skills "$source_root" "$package")
      for skill_path in $skill_paths; do
        require_plugin_relative_path "$skill_path"
        [ -f "$source_root/packages/$package/$skill_path/SKILL.md" ] \
          || die "package skill is missing: $package/$skill_path"
        if [ "$first" = true ]; then
          first=false
        else
          printf ',\n'
        fi
        printf '    "./packages/%s/%s"' "$package" "$skill_path"
      done
    done
    printf '\n  ],\n'
    printf '%s\n' '  "hooks": "./hooks/hooks.json"'
    printf '%s\n' '}'
  } >"$destination"
}

write_plugin_hooks() {
  source_root=$1
  packages=$2
  destination=$3
  entries="$destination.entries.$$"
  : >"$entries"

  for package in $packages; do
    package_adapter_hooks "$source_root" "$package" \
      | while IFS="$(printf '\t')" read -r event matcher command timeout; do
          [ -n "$event" ] || continue
          require_plugin_relative_path "$command"
          case "$event" in ''|*[!A-Za-z]*) die "package hook has invalid event: $event" ;; esac
          case "$matcher" in ''|*[!A-Za-z'|-']*) die "package hook has invalid matcher: $matcher" ;; esac
          case "$timeout" in ''|*[!0-9]*) die "package hook has invalid timeout: $timeout" ;; esac
          [ -f "$source_root/packages/$package/$command" ] \
            || die "package hook handler is missing: $package/$command"
          printf '%s\t%s\t%s\t%s\t%s\n' "$package" "$event" "$matcher" "$command" "$timeout" >>"$entries"
        done
  done

  {
    printf '%s\n' '{'
    printf '%s\n' '  "hooks": {'
    events=$(cut -f2 "$entries" | LC_ALL=C sort -u)
    first_event=true
    for event in $events; do
      if [ "$first_event" = true ]; then
        first_event=false
      else
        printf ',\n'
      fi
      printf '    "%s": [\n' "$event"
      first_hook=true
      while IFS="$(printf '\t')" read -r package entry_event matcher command timeout; do
        [ "$entry_event" = "$event" ] || continue
        if [ "$first_hook" = true ]; then
          first_hook=false
        else
          printf ',\n'
        fi
        printf '%s\n' '      {'
        [ "$matcher" = - ] || printf '        "matcher": "%s",\n' "$matcher"
        cat <<EOF
        "hooks": [
          {
            "type": "command",
            "command": "sh \"\${CLAUDE_PLUGIN_ROOT}/packages/$package/$command\"",
            "timeout": $timeout
          }
        ]
      }
EOF
      done <"$entries"
      printf '\n    ]'
    done
    printf '\n  }\n}\n'
  } >"$destination"
  rm -f "$entries"
}

write_plugin_wrapper() {
  source_root=$1
  destination=$2
  cat >"$destination" <<EOF
#!/bin/sh
export ENGSYS_SYSTEM_ROOT=$(shell_quote "$source_root")
exec $(shell_quote "$source_root/bin/engsys") "\$@"
EOF
  chmod +x "$destination"
}

plugin_view_is_ready() {
  view=$1
  revision=$2
  profile=$3
  [ -f "$view/.engsys-view" ] && [ -f "$view/.claude-plugin/plugin.json" ] \
    && [ -f "$view/hooks/hooks.json" ] && [ -x "$view/bin/engsys" ] \
    && grep -Fxq "revision=$revision" "$view/.engsys-view" \
    && grep -Fxq "profile=$profile" "$view/.engsys-view"
}

materialize_plugin_view() {
  project_dir=$1
  source_root=$2
  lock="$project_dir/.engsys/lock.yaml"
  contract="$project_dir/.engsys/project.yaml"
  revision=$(lock_system_revision "$lock")
  profile=$(project_profile "$contract")
  require_profile_name "$profile"
  packages=$(lock_package_names "$lock")
  [ -n "$packages" ] || die "lock has no packages"
  package_key=$(printf '%s\n' "$packages" | LC_ALL=C sort | cksum | awk '{print $1}')
  view="$(cache_root)/plugins/$revision/$profile-$package_key"

  if [ -e "$view" ]; then
    plugin_view_is_ready "$view" "$revision" "$profile" && {
      printf '%s\n' "$view"
      return
    }
    die "cached plugin view is incomplete or incompatible: $view"
  fi

  temporary="$view.tmp.$$"
  cleanup_view_temporary() {
    view_status=$?
    rm -rf "$temporary"
    trap - 0 1 2 15
    exit "$view_status"
  }
  trap cleanup_view_temporary 0 1 2 15
  mkdir -p "$temporary/.claude-plugin" "$temporary/bin" "$temporary/hooks" "$temporary/packages"
  for package in $packages; do
    [ -d "$source_root/packages/$package" ] \
      || die "package is missing from locked system revision: $package"
    cp -R "$source_root/packages/$package" "$temporary/packages/$package"
  done
  write_plugin_manifest "$source_root" "$packages" "$temporary/.claude-plugin/plugin.json"
  write_plugin_hooks "$source_root" "$packages" "$temporary/hooks/hooks.json"
  write_plugin_wrapper "$source_root" "$temporary/bin/engsys"
  {
    printf 'revision=%s\n' "$revision"
    printf 'profile=%s\n' "$profile"
    printf '%s\n' "$packages"
  } >"$temporary/.engsys-view"
  mkdir -p "$(dirname "$view")"
  if [ -e "$view" ]; then
    # 동시 실행이 같은 view를 먼저 완성했다. 승자를 쓰고 임시본은 버린다.
    rm -rf "$temporary"
    trap - 0 1 2 15
    plugin_view_is_ready "$view" "$revision" "$profile" \
      || die "cached plugin view is incomplete or incompatible: $view"
    printf '%s\n' "$view"
    return
  fi
  mv "$temporary" "$view"
  trap - 0 1 2 15
  printf '%s\n' "$view"
}

resolve_locked_plugin() {
  project_dir=$1
  lock="$project_dir/.engsys/lock.yaml"
  [ -f "$lock" ] || die "missing .engsys/lock.yaml"
  revision=$(lock_system_revision "$lock")
  [ -n "$revision" ] || die "lock has no system revision"
  require_safe_revision "$revision"

  if [ "$(system_revision)" = "$revision" ] && system_is_clean; then
    printf '%s\n' "$system_root"
    return
  fi

  cache_dir="$(cache_root)/releases/$revision"
  if [ -d "$cache_dir" ]; then
    cached_revision=$(git -C "$cache_dir" rev-parse HEAD 2>/dev/null || true)
    [ "$cached_revision" = "$revision" ] || die "cached revision is invalid: $cache_dir"
    [ -z "$(git -C "$cache_dir" status --porcelain --untracked-files=no 2>/dev/null)" ] \
      || die "cached revision has local changes: $cache_dir"
    printf '%s\n' "$cache_dir"
    return
  fi

  if ! git -C "$system_root" cat-file -e "$revision^{commit}" 2>/dev/null; then
    git -C "$system_root" fetch --quiet origin
  fi
  git -C "$system_root" cat-file -e "$revision^{commit}" 2>/dev/null \
    || die "locked revision is unavailable from origin: $revision"
  mkdir -p "$(cache_root)/releases"
  git -C "$system_root" worktree add --quiet --detach "$cache_dir" "$revision" \
    || die "could not prepare cached revision: $revision"
  printf '%s\n' "$cache_dir"
}

list_contains() {
  printf '%s\n' "$1" | grep -Fxq "$2"
}

top_level_keys() {
  sed -n 's/^\([A-Za-z][A-Za-z0-9_-]*\):.*$/\1/p' "$1"
}

project_verify_command() {
  command=$(sed -n 's/^  verify:[[:space:]]*//p' "$1" | sed -n '1p')
  yaml_unquote "$command"
}

write_status_list() {
  statuses=$1
  old_ifs=$IFS
  IFS=,
  set -- $statuses
  IFS=$old_ifs
  [ "$#" -gt 0 ] || die "lifecycle requires at least one frozen status"

  first=true
  printf '['
  for status in "$@"; do
    [ -n "$status" ] || die "lifecycle contains an empty frozen status"
    if [ "$first" = true ]; then
      first=false
    else
      printf ', '
    fi
    yaml_quote "$status"
  done
  printf ']'
}

write_project_contract() {
  project_dir=$1
  profile=$2
  name=$3
  verify=$4
  sources=$5
  policy=$6
  architecture=$7
  generated=$8
  lifecycles=$9

  {
    printf '%s\n' 'system:'
    printf '  profile: '; yaml_quote "$profile"; printf '\n\n'
    printf '%s\n' 'project:'
    printf '  name: '; yaml_quote "$name"; printf '\n'
    if [ -n "$sources" ]; then
      printf '%s\n' '  source-of-truth:'
      printf '%s\n' "$sources" | while IFS="$(printf '\t')" read -r source_name source_path; do
        printf '    %s: ' "$source_name"; yaml_quote "$source_path"; printf '\n'
      done
    else
      printf '%s\n' '  source-of-truth: {}'
    fi
    printf '\n%s\n' 'commands:'
    printf '  verify: '; yaml_quote "$verify"; printf '\n\n'
    printf '%s\n' 'documentation:'
    if [ -n "$policy" ]; then
      printf '  policy: '; yaml_quote "$policy"; printf '\n'
    fi
    if [ -n "$architecture" ]; then
      printf '  architecture: '; yaml_quote "$architecture"; printf '\n'
    fi
    if [ -n "$generated" ]; then
      printf '%s\n' '  generated:'
      printf '%s\n' "$generated" | while IFS="$(printf '\t')" read -r output command; do
        printf '    - output: '; yaml_quote "$output"; printf '\n'
        printf '      command: '; yaml_quote "$command"; printf '\n'
      done
    else
      printf '%s\n' '  generated: []'
    fi
    if [ -n "$lifecycles" ]; then
      printf '%s\n' '  lifecycle:'
      printf '%s\n' "$lifecycles" | while IFS="$(printf '\t')" read -r lifecycle_name lifecycle_path lifecycle_statuses; do
        printf '    %s:\n' "$lifecycle_name"
        printf '      path: '; yaml_quote "$lifecycle_path"; printf '\n'
        printf '      frozen-status: '; write_status_list "$lifecycle_statuses"; printf '\n'
      done
    else
      printf '%s\n' '  lifecycle: {}'
    fi
    # authoring_assign 과 review_scopes 는 init 의 scope 에서 읽는다. 이 함수는 POSIX shell 이
    # 직접 참조할 수 있는 위치 인자를 이미 모두 쓴다.
    if [ -n "${authoring_assign:-}" ]; then
      printf '%s\n' '  authoring:'
      printf '%s\n' '    assign:'
      printf '%s\n' "$authoring_assign" | while IFS="$(printf '\t')" read -r assign_path assign_type; do
        [ -n "$assign_path" ] || continue
        printf '      - path: '; yaml_quote "$assign_path"; printf '\n'
        printf '        type: '; yaml_quote "$assign_type"; printf '\n'
      done
    fi
    if [ -n "${review_scopes:-}" ]; then
      printf '%s\n' '  review:'
      printf '%s\n' '    scopes:'
      printf '%s\n' "$review_scopes" | while IFS= read -r review_scope; do
        [ -n "$review_scope" ] || continue
        printf '      - '; yaml_quote "$review_scope"; printf '\n'
      done
    fi
    if [ -n "${vcs_model:-}" ]; then
      printf '\n%s\n' 'vcs:'
      printf '%s\n' '  branch:'
      printf '    model: '; yaml_quote "$vcs_model"; printf '\n'
      if [ -n "${vcs_roles:-}" ]; then
        printf '%s\n' '    roles:'
        printf '%s\n' "$vcs_roles" | while IFS="$(printf '\t')" read -r role_name role_branch; do
          [ -n "$role_name" ] || continue
          printf '      - role: '; yaml_quote "$role_name"; printf '\n'
          printf '        branch: '; yaml_quote "$role_branch"; printf '\n'
        done
        printf '%s\n' '    protected:'
        printf '%s\n' "$vcs_roles" | while IFS="$(printf '\t')" read -r role_name role_branch; do
          [ -n "$role_branch" ] || continue
          printf '      - '; yaml_quote "$role_branch"; printf '\n'
        done
      fi
    fi
  } >"$project_dir/.engsys/project.yaml"
}

write_lock() {
  project_dir=$1
  profile=$2
  lock_destination=${3:-"$project_dir/.engsys/lock.yaml"}
  revision=$(system_revision)
  [ "$revision" != unversioned ] \
    || die "system checkout is not a Git repository; cannot record a lock revision"
  # 검증은 working tree로 돌지만 lock은 commit만 가리킬 수 있다. 어긋남을 조용히 넘기지 않는다.
  system_is_clean || printf '%s\n' \
    "engsys: warning: system checkout has uncommitted changes; the lock records committed revision $revision" >&2

  {
    printf '%s\n' 'lock-version: 1'
    printf '%s\n' 'system:'
    printf '%s\n' '  repository: github.com/pis-o-cake/engineering-system'
    printf '  revision: '; yaml_quote "$revision"; printf '\n'
    printf 'profile: '; yaml_quote "$profile"; printf '\n'
    printf '%s\n' 'packages:'
    profile_packages "$profile" | while IFS= read -r package; do
      [ -f "$system_root/packages/$package/package.yaml" ] || die "profile references missing package: $package"
      version=$(package_version "$package")
      [ -n "$version" ] || die "package has no version: $package"
      printf '  %s:\n' "$package"
      printf '    version: '; yaml_quote "$version"; printf '\n'
      printf '    revision: '; yaml_quote "$revision"; printf '\n'
    done
  } >"$lock_destination"
}

extract_generated_paths() {
  awk -v requested=output -f "$system_root/lib/generated-documents.awk" "$1"
}

extract_generated_commands() {
  awk -v requested=command -f "$system_root/lib/generated-documents.awk" "$1"
}

sync_generated_paths() {
  project_dir=$1
  destination=$2
  temporary="$destination.tmp.$$"
  cleanup_temporary() {
    cleanup_status=$?
    rm -f "$temporary"
    trap - 0 1 2 15
    exit "$cleanup_status"
  }
  trap cleanup_temporary 0 1 2 15
  extract_generated_paths "$project_dir/.engsys/project.yaml" >"$temporary"
  while IFS= read -r output || [ -n "$output" ]; do
    require_relative_path "$output"
  done <"$temporary"
  mv "$temporary" "$destination"
  trap - 0 1 2 15
}

# Detection fills declarations a new project would otherwise type by hand. Every value it
# writes is reported, and any explicit option wins over it.
detect_verify_command() {
  dir=$1
  if [ -f "$dir/Makefile" ]; then
    if grep -Eq '^check[[:space:]]*:' "$dir/Makefile"; then printf 'make check'; return; fi
    if grep -Eq '^test[[:space:]]*:' "$dir/Makefile"; then printf 'make test'; return; fi
  fi
  if [ -f "$dir/pyproject.toml" ]; then
    if grep -q '\[tool\.poe' "$dir/pyproject.toml"; then printf 'poe check'; return; fi
    printf 'pytest'; return
  fi
  if [ -f "$dir/package.json" ] && grep -q '"test"[[:space:]]*:' "$dir/package.json"; then
    printf 'npm test'; return
  fi
  if [ -f "$dir/gradlew" ]; then printf './gradlew check'; return; fi
  if [ -f "$dir/go.mod" ]; then printf 'go test ./...'; return; fi
  if [ -f "$dir/Cargo.toml" ]; then printf 'cargo test'; return; fi
}

# A path only gets a type assignment while it holds no authored document. Assigning a
# directory of untyped documents would fail every check from the first run.
path_has_documents() {
  target="$1/$2"
  if [ -f "$target" ]; then return 0; fi
  [ -d "$target" ] || return 1
  found=$(find "$target" -type f \( -name '*.md' -o -name '*.html' \) -print 2>/dev/null | head -1)
  [ -n "$found" ]
}

detect_declarations() {
  dir=$1
  if [ -z "$verify" ]; then
    verify=$(detect_verify_command "$dir")
    [ -z "$verify" ] || printf '%s\n' "detected verify command: $verify"
  fi
  if [ -z "$sources" ]; then
    for candidate in backend frontend infra src app server client migrations; do
      [ -d "$dir/$candidate" ] || continue
      sources="${sources}${sources:+
}$candidate$(printf '\t')$candidate/"
      printf '%s\n' "detected source-of-truth: $candidate -> $candidate/"
    done
  fi
  if [ -z "$policy" ] && [ -f "$dir/docs/documentation-policy.md" ]; then
    policy=docs/documentation-policy.md
    printf '%s\n' "detected documentation policy: $policy"
  fi
  if [ -z "$architecture" ] && [ -f "$dir/docs/architecture/README.md" ]; then
    architecture=docs/architecture/README.md
    printf '%s\n' "detected current architecture: $architecture"
  fi
  if [ -z "$lifecycles" ]; then
    if [ -d "$dir/docs/design" ]; then
      lifecycles="${lifecycles}${lifecycles:+
}design$(printf '\t')docs/design$(printf '\t')implemented"
      printf '%s\n' 'detected lifecycle: design -> docs/design'
    fi
    if [ -d "$dir/docs/adr" ]; then
      lifecycles="${lifecycles}${lifecycles:+
}adr$(printf '\t')docs/adr$(printf '\t')accepted"
      printf '%s\n' 'detected lifecycle: adr -> docs/adr'
    fi
  fi
  detect_authoring "$dir"
  detect_vcs "$dir"
}

detect_vcs() {
  dir=$1
  [ -z "$vcs_model" ] || return 0
  branches=$(git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null || true)
  production=
  development=
  for candidate in main master trunk; do
    case "
$branches" in *"
$candidate"*) production=$candidate; break ;; esac
  done
  for candidate in develop dev development; do
    case "
$branches" in *"
$candidate"*) development=$candidate; break ;; esac
  done
  [ -n "$production" ] || return 0
  if [ -n "$development" ]; then
    vcs_model=env-branch
    vcs_roles="development$(printf '\t')$development
production$(printf '\t')$production"
    printf '%s\n' "detected branch model: env-branch ($development -> $production)"
  else
    vcs_model=single-main
    vcs_roles="production$(printf '\t')$production"
    printf '%s\n' "detected branch model: single-main ($production)"
  fi
}

detect_authoring() {
  dir=$1
  [ -z "$authoring_assign" ] || return 0
  pending=
  for pair in 'README.md guide' 'docs/adr decision-record' 'docs/architecture architecture' \
              'docs/design design-proposal'; do
    candidate=${pair%% *}
    type_name=${pair##* }
    if path_has_documents "$dir" "$candidate"; then
      pending="${pending}${pending:+, }$candidate"
      continue
    fi
    [ -e "$dir/$candidate" ] || [ "$candidate" = README.md ] || continue
    authoring_assign="${authoring_assign}${authoring_assign:+
}$candidate$(printf '\t')$type_name"
    printf '%s\n' "assigned document type: $candidate -> $type_name"
  done
  [ -z "$pending" ] || printf '%s\n' \
    "not assigned because documents already exist there: $pending
  declare a type on each document, then add it to documentation.authoring.assign"
}

write_project_hook() {
  dir=$1
  mkdir -p "$dir/.githooks"
  for hook_name in commit-msg pre-push; do
    source_hook="$system_root/templates/project/.githooks/$hook_name"
    [ -f "$source_hook" ] || die "hook template is missing: $source_hook"
    if [ -e "$dir/.githooks/$hook_name" ]; then
      printf 'kept the existing .githooks/%s\n' "$hook_name"
    else
      cp "$source_hook" "$dir/.githooks/$hook_name"
      chmod +x "$dir/.githooks/$hook_name"
      hook_seed_hash=$(git hash-object -- "$source_hook")
      record_hook_baseline "$dir" "$hook_name" "$hook_seed_hash" "$hook_seed_hash"
      printf 'wrote .githooks/%s\n' "$hook_name"
    fi
  done
  current=$(git -C "$dir" config --get core.hooksPath 2>/dev/null || true)
  if [ -z "$current" ]; then
    git -C "$dir" config core.hooksPath .githooks
    printf '%s\n' 'registered core.hooksPath .githooks'
  elif [ "$current" = .githooks ]; then
    printf '%s\n' 'core.hooksPath is already .githooks'
  else
    printf '%s\n' "left core.hooksPath as $current; run the gate from there or change it yourself"
  fi
}

init() {
  project_dir=$(pwd)
  profile=baseline
  name=
  verify=
  sources=
  policy=
  architecture=
  generated=
  lifecycles=
  authoring_assign=
  review_scopes=
  vcs_model=
  vcs_roles=
  detect=false
  hooks=false
  dry_run=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --detect) detect=true; shift ;;
      --dry-run) dry_run=true; shift ;;
      --hooks) hooks=true; shift ;;
      --profile) require_value "$@"; profile=$2; shift 2 ;;
      --name) require_value "$@"; name=$2; shift 2 ;;
      --verify) require_value "$@"; verify=$2; shift 2 ;;
      --source)
        require_value "$@"
        source_name=${2%%=*}
        source_path=${2#*=}
        [ "$source_name" != "$source_path" ] && [ -n "$source_name" ] && [ -n "$source_path" ] \
          || die "--source must be name=path"
        case "$source_name" in *[!A-Za-z0-9_-]*) die "invalid source name: $source_name" ;; esac
        require_relative_path "$source_path"
        sources="${sources}${sources:+
}$source_name$(printf '\t')$source_path"
        shift 2
        ;;
      --policy) require_value "$@"; policy=$2; require_relative_path "$policy"; shift 2 ;;
      --architecture) require_value "$@"; architecture=$2; require_relative_path "$architecture"; shift 2 ;;
      --generated)
        [ "$#" -ge 3 ] || die "--generated requires an output path and command"
        require_relative_path "$2"
        [ -n "$3" ] || die "generated document command must not be empty"
        generated="${generated}${generated:+
}$2$(printf '\t')$3"
        shift 3
        ;;
      --lifecycle)
        [ "$#" -ge 4 ] || die "--lifecycle requires a name, path, and frozen statuses"
        case "$2" in ''|*[!A-Za-z0-9_-]*) die "invalid lifecycle name: $2" ;; esac
        require_relative_path "$3"
        [ -n "$4" ] || die "lifecycle requires frozen statuses"
        lifecycles="${lifecycles}${lifecycles:+
}$2$(printf '\t')$3$(printf '\t')$4"
        shift 4
        ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown init option: $1" ;;
    esac
  done

  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  require_profile "$profile"

  if [ -e "$project_dir/.engsys/project.yaml" ] || [ -e "$project_dir/.engsys/lock.yaml" ]; then
    die "project contract already exists; inspect it and use engsys sync or upgrade instead"
  fi

  [ "$detect" = false ] || detect_declarations "$project_dir"
  [ -n "$verify" ] \
    || die "--verify is required; detection found no native verification command in $project_dir"
  [ -n "$name" ] || name=$(basename "$project_dir")

  if [ "$dry_run" = true ]; then
    dry_root=$(mktemp -d)
    mkdir -p "$dry_root/.engsys"
    write_project_contract "$dry_root" "$profile" "$name" "$verify" "$sources" "$policy" \
      "$architecture" "$generated" "$lifecycles"
    printf '\n%s\n' '--- .engsys/project.yaml (미리보기, 쓰지 않음) ---'
    cat "$dry_root/.engsys/project.yaml"
    printf '%s\n' '--- 끝 ---'
    [ "$hooks" = false ] || printf '\n%s\n' \
      '--hooks: .githooks/commit-msg 와 .githooks/pre-push 를 심고 core.hooksPath 를 설정한다'
    rm -rf "$dry_root"
    printf '\n%s\n' "Nothing was written. Re-run without --dry-run to apply."
    return
  fi

  mkdir -p "$project_dir/.engsys" "$project_dir/.claude/rules"
  write_project_contract "$project_dir" "$profile" "$name" "$verify" "$sources" "$policy" "$architecture" "$generated" "$lifecycles"
  write_lock "$project_dir" "$profile"
  sync_generated_paths "$project_dir" "$project_dir/.engsys/generated-paths.txt"

  route="$project_dir/.claude/rules/engineering-system.md"
  if [ ! -e "$route" ]; then
    cp "$system_root/templates/project/.claude/rules/engineering-system.md" "$route"
  fi

  [ "$hooks" = false ] || write_project_hook "$project_dir"

  printf '%s\n' "Initialized Engineering System contract in $project_dir"
}

docs() {
  project_dir=$(pwd)
  docs_action=${1:-check}
  action=$docs_action
  case "$action" in
    check|new) shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown docs action: $action" ;;
  esac
  if [ "$docs_action" = new ]; then
    ENGSYS_SYSTEM_ROOT="$system_root" \
      sh "$system_root/packages/docs-gov/bin/new-document.sh" "$@"
    return
  fi
  docs_path=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --path) require_value "$@"; docs_path=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown docs option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  set -- --project "$project_dir"
  [ -z "$docs_path" ] || set -- "$@" --path "$docs_path"
  ENGSYS_SYSTEM_ROOT="$system_root" \
    sh "$system_root/packages/docs-gov/bin/check-structure.sh" "$@"
}

# 프로젝트가 고정한 revision 으로 실행을 넘긴다. PATH 의 engsys 는 실행기이고, 판정하는 코드는
# 언제나 그 프로젝트의 lock 이 가리키는 release 에서 온다. 그러지 않으면 같은 프로젝트를 검사한
# 결과가 개발자마다 달라진다.
project_from_arguments() {
  argument_project=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project)
        if [ "$#" -ge 2 ]; then argument_project=$2; shift 2; else shift; fi
        ;;
      *) shift ;;
    esac
  done
  printf '%s' "$argument_project"
}

exec_locked_revision() {
  locked_command=$1
  shift
  # 재귀 방지, 개발용 탈출구, 그리고 이 레포 자신은 자기 working tree 로 돈다.
  [ -z "${ENGSYS_PINNED:-}" ] || return 0
  [ -z "${ENGSYS_USE_CHECKOUT:-}" ] || return 0

  locked_project=$(project_from_arguments "$@")
  [ -d "$locked_project" ] || return 0
  locked_project=$(CDPATH= cd -- "$locked_project" && pwd -P)
  [ "$locked_project" != "$system_root" ] || return 0

  locked_file="$locked_project/.engsys/lock.yaml"
  [ -f "$locked_file" ] || return 0
  locked_revision=$(lock_system_revision "$locked_file")
  [ -n "$locked_revision" ] || return 0
  # working tree 의 수정은 revision 을 바꾸지 않는다. 같은 commit 이면 그대로 돈다.
  [ "$locked_revision" != "$(system_revision)" ] || return 0

  if ! locked_root=$(resolve_locked_plugin "$locked_project" 2>/dev/null); then
    # --revision 은 전송 gate 의 표시다. 그 경로에서 다른 revision 으로 대체 실행하면 gate 가
    # 무엇을 판정했는지 알 수 없다. 탐색용 실행에서만 현재 checkout 으로 넘어간다.
    case " $* " in
      *' --revision '*)
        die "locked revision $locked_revision is unavailable; fetch it before running a gate" ;;
    esac
    printf '%s\n' \
      "engsys: warning: locked revision $locked_revision is unavailable; ran this checkout instead" >&2
    return 0
  fi
  [ -x "$locked_root/bin/engsys" ] || return 0
  ENGSYS_PINNED=1 exec "$locked_root/bin/engsys" "$locked_command" "$@"
}

# 프로젝트가 복사한 hook 은 그 프로젝트가 소유한다. 표준이 덮어쓰지 않으므로 사본이 template 과
# 언제 갈라졌는지 알 방법이 필요하다. 기록은 두 해시다 — 사본이 근거한 template, 그리고 기록
# 시점의 사본. 둘을 함께 두어야 설치 직후와 프로젝트가 고친 뒤 유지하기로 한 것을 구분한다.
hook_names() { printf '%s\n' commit-msg pre-push; }
hook_record() { printf '%s/.engsys/hooks.txt' "$1"; }

hook_recorded() {
  hook_record_file=$(hook_record "$1")
  [ -f "$hook_record_file" ] || return 0
  awk -v name="$2" -v column="$3" '$1 == name { print $column; exit }' "$hook_record_file"
}

hook_state() {
  hook_project=$1
  hook_name=$2
  hook_template="$system_root/templates/project/.githooks/$hook_name"
  hook_installed="$hook_project/.githooks/$hook_name"
  [ -f "$hook_template" ] || { printf 'unknown'; return; }
  [ -f "$hook_installed" ] || { printf 'missing'; return; }
  template_hash=$(git hash-object -- "$hook_template")
  installed_hash=$(git hash-object -- "$hook_installed")
  [ "$installed_hash" != "$template_hash" ] || { printf 'current'; return; }

  recorded_template=$(hook_recorded "$hook_project" "$hook_name" 2)
  recorded_installed=$(hook_recorded "$hook_project" "$hook_name" 3)
  [ -n "$recorded_installed" ] || { printf 'modified'; return; }
  [ "$installed_hash" = "$recorded_installed" ] || { printf 'modified'; return; }
  [ "$recorded_template" != "$template_hash" ] || { printf 'owned'; return; }
  [ "$recorded_installed" = "$recorded_template" ] || { printf 'modified'; return; }
  printf 'outdated'
}

record_hook_baseline() {
  hook_project=$1
  hook_name=$2
  hook_template_hash=$3
  hook_installed_hash=$4
  hook_record_file=$(hook_record "$hook_project")
  mkdir -p "$(dirname "$hook_record_file")"
  if [ -f "$hook_record_file" ]; then
    awk -v name="$hook_name" '$1 != name' "$hook_record_file" >"$hook_record_file.next"
  else
    : >"$hook_record_file.next"
  fi
  printf '%s\t%s\t%s\n' "$hook_name" "$hook_template_hash" "$hook_installed_hash" \
    >>"$hook_record_file.next"
  LC_ALL=C sort -o "$hook_record_file.next" "$hook_record_file.next"
  mv -f "$hook_record_file.next" "$hook_record_file"
}

hooks() {
  project_dir=$(pwd)
  hooks_action=${1:-status}
  case "$hooks_action" in
    status|update) shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown hooks action: $hooks_action" ;;
  esac
  hooks_force=false
  hooks_adopt=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --force) hooks_force=true; shift ;;
      --adopt) hooks_adopt=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown hooks option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  hooks_pending=0

  for hook_name in $(hook_names); do
    state=$(hook_state "$project_dir" "$hook_name")
    template="$system_root/templates/project/.githooks/$hook_name"
    installed="$project_dir/.githooks/$hook_name"
    # --adopt 는 사본을 그대로 두고 현재 template 을 확인한 것으로만 기록한다.
    if [ "$hooks_action" = update ] && [ "$hooks_adopt" = true ] \
      && [ "$state" != missing ] && [ "$state" != current ] && [ "$state" != unknown ]; then
      record_hook_baseline "$project_dir" "$hook_name" "$(git hash-object -- "$template")" \
        "$(git hash-object -- "$installed")"
      printf 'adopted  %s — 현재 사본을 유지한다. 이후 template이 바뀔 때 다시 알린다\n' "$hook_name"
      continue
    fi
    install_hook() {
      mkdir -p "$project_dir/.githooks"
      cp "$template" "$installed"
      chmod +x "$installed"
      hook_new_hash=$(git hash-object -- "$template")
      record_hook_baseline "$project_dir" "$hook_name" "$hook_new_hash" "$hook_new_hash"
    }
    case "$state" in
      current) printf 'ok       %s는 현재 template과 같다\n' "$hook_name" ;;
      owned) printf 'ok       %s는 프로젝트가 소유한 사본이다. 현재 template을 확인한 상태다\n' "$hook_name" ;;
      missing)
        if [ "$hooks_action" = update ]; then
          install_hook
          printf 'wrote    %s\n' "$hook_name"
        else
          printf 'missing  %s — engsys hooks update로 설치한다\n' "$hook_name"
          hooks_pending=$((hooks_pending + 1))
        fi
        ;;
      outdated)
        if [ "$hooks_action" = update ]; then
          install_hook
          printf 'updated  %s\n' "$hook_name"
        else
          printf 'outdated %s — 사본을 고치지 않았고 template이 바뀌었다. engsys hooks update로 갱신한다\n' "$hook_name"
          hooks_pending=$((hooks_pending + 1))
        fi
        ;;
      modified)
        if [ "$hooks_action" = update ] && [ "$hooks_force" = true ]; then
          install_hook
          printf 'replaced %s — 프로젝트의 수정을 버렸다\n' "$hook_name"
        else
          printf 'modified %s — 프로젝트가 고친 사본이다. 갱신하면 그 수정이 사라진다\n' "$hook_name"
          printf '         차이: diff %s %s\n' "$installed" "$template"
          printf '         갱신: engsys hooks update --force · 유지: engsys hooks update --adopt\n'
          hooks_pending=$((hooks_pending + 1))
        fi
        ;;
      *) printf 'unknown  %s — template이 이 revision에 없다\n' "$hook_name" ;;
    esac
  done

  [ "$hooks_action" = status ] || return 0
  [ "$hooks_pending" -eq 0 ] || return 1
}

# 채택은 여러 단계이고 각 단계가 무엇을 바꾸는지 사람이 보고 넘어가야 한다. 다른 명령은
# 비대화형으로 남기고, 이 명령만 단계마다 확인하고 실행한 뒤 다시 검사한다.
setup_step=0
# 어느 단계에서 멈췄는지는 subshell 밖에서 읽어야 한다. 실패하면 그 shell 이 사라지기 때문이다.
setup_say() {
  setup_step=$((setup_step + 1))
  printf '\n[%s] %s\n' "$setup_step" "$1"
  [ -z "${setup_state:-}" ] || printf '%s\t%s\n' "$setup_step" "$1" >"$setup_state"
}
setup_ok() { printf '    ok   %s\n' "$1"; }
setup_note() { printf '    ·    %s\n' "$1"; }
setup_warn() { printf '    warn %s\n' "$1"; }

setup_ask() {
  [ "$setup_yes" = false ] || { printf '    -> %s [자동 예]\n' "$1"; return 0; }
  printf '    -> %s [y/N] ' "$1"
  read -r setup_answer || setup_answer=n
  case "$setup_answer" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

# 실패하면 어디서 왜 멈췄는지와 다음에 무엇을 할지 남긴다. 한 줄만 찍고 끝나면 터미널을
# 닫는 순간 사라지고, 무엇을 고쳐야 하는지도 알 수 없다.
setup() {
  setup_state=$(mktemp)
  setup_status=$(mktemp)
  setup_target=$(mktemp)
  setup_log="$(printf '%s' "${TMPDIR:-/tmp}" | sed 's|/*$||')/engsys-setup-$$.log"
  printf '1\n' >"$setup_status"
  printf '0\t시작 전\n' >"$setup_state"
  printf '%s\n' "$(pwd)" >"$setup_target"

  ( setup_body "$@" && printf '0\n' >"$setup_status" ) 2>&1 | tee "$setup_log"

  setup_result=$(cat "$setup_status")
  setup_where=$(cut -f2 "$setup_state")
  setup_where_number=$(cut -f1 "$setup_state")
  setup_project_dir=$(cat "$setup_target")
  rm -f "$setup_state" "$setup_status" "$setup_target"

  if [ "$setup_result" = 0 ]; then
    printf '\n전체 기록: %s\n' "$setup_log"
    return 0
  fi

  printf '\n%s\n' '----------------------------------------------------------------'
  printf '멈춘 곳: [%s] %s\n' "$setup_where_number" "$setup_where"
  printf '위의 마지막 오류 줄이 이유다. 아무것도 되돌리지 않았으니 고치고 다시 실행하면 된다.\n\n'
  printf '  지금 상태 보기 : engsys doctor --project %s\n' "$setup_project_dir"
  printf '  다시 실행      : engsys setup --project %s\n' "$setup_project_dir"
  printf '  전체 기록      : %s\n' "$setup_log"
  printf '%s\n' '----------------------------------------------------------------'
  return 1
}

setup_body() {
  project_dir=$(pwd)
  setup_yes=false
  setup_project_given=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; setup_project_given=true; shift 2 ;;
      --yes) setup_yes=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown setup option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  [ -z "${setup_target:-}" ] || printf '%s\n' "$project_dir" >"$setup_target"
  # 시스템 checkout 안에서 --project 없이 실행하면 표준 자신을 대상으로 잡는다. 거의 언제나
  # 실수이므로 무엇을 해야 하는지 알린다.
  if [ "$project_dir" = "$system_root" ] && [ "$setup_project_given" = false ]; then
    die "대상이 표준 저장소 자신이다. 붙일 프로젝트 디렉토리에서 실행하거나 --project 를 준다"
  fi
  # 물어볼 수 없는데 진행하면 조용히 전부 거절한 것과 같아진다. 그 상태로 끝내지 않는다.
  [ -t 0 ] || [ "$setup_yes" = true ] \
    || die '터미널이 없어 단계마다 물어볼 수 없다. --yes 를 주거나 각 명령을 직접 실행한다'
  printf 'Engineering System 채택을 단계별로 진행한다.\n'
  printf '각 단계는 먼저 확인하고, 바꿀 것을 보여 준 뒤, 동의를 받고 실행한다.\n'
  printf '시스템: %s\n대상  : %s\n' "$system_root" "$project_dir"

  setup_say '전제 도구'
  command -v git >/dev/null 2>&1 || die 'git 이 없다. 먼저 설치한다'
  setup_ok "git $(git --version 2>/dev/null | awk '{print $3}')"
  if command -v python3 >/dev/null 2>&1; then
    setup_ok 'python3 (커밋 subject 글자 수를 정확히 센다)'
  else
    setup_warn 'python3 없음 — UTF-8 로케일의 wc 로 떨어진다. 동작은 한다'
  fi
  command -v claude >/dev/null 2>&1 && setup_ok 'Claude Code' \
    || setup_warn 'Claude Code 없음 — engsys claude 만 못 쓴다'

  setup_say '시스템 checkout'
  revision=$(system_revision)
  [ "$revision" != unversioned ] || die '시스템 checkout 이 Git 저장소가 아니다'
  setup_ok "revision $revision"
  system_is_clean || setup_warn '수정된 파일이 있다. lock 은 commit 만 가리킨다'
  if git -C "$system_root" merge-base --is-ancestor "$revision" origin/main 2>/dev/null; then
    setup_ok 'origin/main 에서 도달 가능한 revision 이다'
  else
    setup_warn 'origin/main 에 없는 revision 이다. 팀원이 이 lock 을 받지 못한다'
  fi

  setup_say '개발자 활성화 (이 머신에 한 번)'
  resolved=$(command -v engsys 2>/dev/null || true)
  if [ -n "$resolved" ] && same_file "$resolved" "$system_root/bin/engsys"; then
    setup_ok "engsys 가 PATH 에 있다: $resolved"
  else
    setup_note 'PATH 에 없다. install.sh 가 shell profile 한 줄과 이 clone 의 hook 경로를 설정한다'
    if setup_ask 'install.sh 를 실행할까'; then
      sh "$system_root/install.sh" || die 'install.sh 가 실패했다'
    else
      setup_warn '건너뛴다. 새 shell 에서 engsys 를 찾지 못하면 다시 실행한다'
    fi
  fi

  setup_say '대상 프로젝트'
  require_worktree "$project_dir"
  setup_ok "Git worktree 다: $project_dir"
  if [ -f "$project_dir/.engsys/project.yaml" ]; then
    setup_ok '계약이 이미 있다. 새로 만들지 않는다'
  else
    setup_note '계약이 없다. 감지 결과를 먼저 보여 준다'
    printf '\n'
    "$system_root/bin/engsys" init --project "$project_dir" --detect --hooks --dry-run \
      || die '감지에 실패했다. --verify 로 검증 명령을 직접 준다'
    printf '\n'
    if setup_ask '위 내용으로 계약과 Git hook 을 만들까'; then
      "$system_root/bin/engsys" init --project "$project_dir" --detect --hooks || return 1
    else
      setup_warn '건너뛴다. engsys init 을 직접 실행한 뒤 이 명령을 다시 돌린다'
      return 0
    fi
  fi

  setup_say 'Git hook'
  for hook_name in $(hook_names); do
    setup_note "$hook_name: $(hook_state "$project_dir" "$hook_name")"
  done
  if "$system_root/bin/engsys" hooks status --project "$project_dir" >/dev/null 2>&1; then
    setup_ok '사본이 현재 template 과 맞다'
  elif setup_ask 'hook 을 설치하거나 갱신할까 (고친 사본은 건드리지 않는다)'; then
    "$system_root/bin/engsys" hooks update --project "$project_dir" \
      || setup_warn 'hook 갱신이 끝나지 않았다. 위 출력을 보고 직접 처리한다'
  fi
  hooks_path=$(git -C "$project_dir" config --get core.hooksPath 2>/dev/null || true)
  [ -n "$hooks_path" ] && setup_ok "core.hooksPath = $hooks_path" \
    || setup_warn 'core.hooksPath 가 없다. hook 이 돌지 않는다'

  setup_say '검사'
  "$system_root/bin/engsys" check --project "$project_dir" >/dev/null \
    || die '계약 검사가 실패했다. 위 오류를 먼저 고친다'
  setup_ok '계약과 lock 이 engsys check 를 통과한다'
  if setup_ask 'engsys verify 까지 돌릴까 (프로젝트의 native test 를 포함해 시간이 걸린다)'; then
    "$system_root/bin/engsys" verify --project "$project_dir" || return 1
  else
    setup_note '나중에 engsys verify 로 확인한다'
  fi

  setup_say '최종 진단'
  # 중간 단계가 경고만 내고 넘어갔을 수 있다. 마지막에 한 번 더 전체를 보고, 남은 문제가 있으면
  # 성공으로 끝내지 않는다. 그러지 않으면 FAIL 을 본 사람이 무엇이 남았는지 알 수 없다.
  if "$system_root/bin/engsys" doctor --project "$project_dir"; then
    setup_ok 'doctor 가 고칠 문제를 찾지 못했다'
  else
    setup_warn '위 FAIL 항목이 남아 있다. 각 줄이 실행할 명령을 알려 준다'
    return 1
  fi

  setup_say '남은 것'
  grep -q '^  authoring:' "$project_dir/.engsys/project.yaml" 2>/dev/null \
    && setup_ok '문서 유형 배정이 선언돼 있다' \
    || setup_note '문서 유형 배정이 없다. 문서를 만들 때 documentation.authoring 에 경로를 배정한다'
  grep -q '^  review:' "$project_dir/.engsys/project.yaml" 2>/dev/null \
    && setup_ok '편집 검토 범위가 선언돼 있다' \
    || setup_note '편집 검토 범위가 없다. 실제로 검토한 문서부터 documentation.review.scopes 에 넣는다'
  setup_note '.engsys/ 와 .githooks/ 를 commit 한다. 그래야 팀원이 같은 계약을 받는다'
  setup_note '팀원은 각자 install.sh 를 돌리고 engsys hooks update 로 hook 을 켠다'
  printf '\n%s\n' '상태는 언제든 engsys doctor 로 다시 본다.'
}

doctor_report() {
  case "$1" in
    ok) printf 'ok    %s\n' "$2" ;;
    warn) printf 'warn  %s\n' "$2" ;;
    fail) printf 'FAIL  %s\n' "$2" >&2 ;;
  esac
  [ -z "${3:-}" ] || case "$1" in
    fail) printf '      %s\n' "$3" >&2 ;;
    *) printf '      %s\n' "$3" ;;
  esac
}

same_file() {
  [ -e "$1" ] && [ -e "$2" ] || return 1
  first=$(CDPATH= cd -- "$(dirname "$1")" && pwd -P)/$(basename "$1")
  second=$(CDPATH= cd -- "$(dirname "$2")" && pwd -P)/$(basename "$2")
  [ "$first" = "$second" ]
}

doctor() {
  project_dir=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown doctor option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  failures=0

  printf '%s\n' "Engineering System: $system_root"
  revision=$(system_revision)
  if [ "$revision" = unversioned ]; then
    doctor_report fail 'system checkout is not a Git repository' \
      "clone the system repository again; a lock cannot record a revision from $system_root"
    failures=$((failures + 1))
  else
    doctor_report ok "system checkout revision $revision"
    system_is_clean || doctor_report warn 'system checkout has uncommitted changes' \
      'a lock records the committed revision, not the working tree'
  fi

  resolved=$(command -v engsys 2>/dev/null || true)
  if [ -z "$resolved" ]; then
    doctor_report fail 'engsys is not on PATH' \
      "add this line to your shell profile: eval \"\$($system_root/bin/engsys shellenv)\""
    failures=$((failures + 1))
  elif same_file "$resolved" "$system_root/bin/engsys"; then
    doctor_report ok "engsys on PATH: $resolved"
  else
    doctor_report warn "engsys on PATH is a different checkout: $resolved" \
      "this run used $system_root/bin/engsys"
  fi

  if command -v claude >/dev/null 2>&1; then
    doctor_report ok 'Claude Code is on PATH'
  else
    doctor_report warn 'Claude Code is not on PATH' \
      'engsys claude needs it; every other command works without it'
  fi

  if [ -d "$system_root/.githooks" ]; then
    hooks_path=$(git -C "$system_root" config --get core.hooksPath 2>/dev/null || true)
    if [ "$hooks_path" = .githooks ]; then
      doctor_report ok 'system push gate is registered'
    else
      doctor_report warn 'system push gate is not registered' \
        "run: git -C $system_root config core.hooksPath .githooks"
    fi
  fi

  printf '\n%s\n' "Project: $project_dir"
  if [ ! -f "$project_dir/.engsys/project.yaml" ]; then
    doctor_report warn 'project has not adopted Engineering System' \
      'run: engsys init --verify <native verify command>'
    printf '\n%s\n' "$failures problem(s) to fix"
    [ "$failures" -eq 0 ] || exit 1
    return
  fi

  if "$system_root/bin/engsys" check --project "$project_dir" >/dev/null 2>&1; then
    doctor_report ok 'project contract and lock pass engsys check'
  else
    doctor_report fail 'project contract or lock does not pass engsys check' \
      "run: engsys check --project $project_dir"
    failures=$((failures + 1))
  fi

  if [ "$project_dir" != "$system_root" ]; then
    project_hooks=$(git -C "$project_dir" config --get core.hooksPath 2>/dev/null || true)
    if [ "$project_hooks" = .githooks ] && [ -f "$project_dir/.githooks/pre-push" ]; then
      doctor_report ok 'project push gate is registered'
    else
      doctor_report warn 'project push gate is not registered' \
        "run: engsys init --hooks, or point core.hooksPath at your own gate"
    fi
  fi

  for hook_name in $(hook_names); do
    case "$(hook_state "$project_dir" "$hook_name")" in
      current|owned|unknown) ;;
      missing) doctor_report warn "project hook is not installed: $hook_name" \
        "run: engsys hooks update --project $project_dir" ;;
      outdated) doctor_report warn "project hook is older than the template: $hook_name" \
        "run: engsys hooks update --project $project_dir" ;;
      modified) doctor_report warn "project hook differs from the template: $hook_name" \
        "the project owns it; engsys hooks status shows the options" ;;
    esac
  done

  contract="$project_dir/.engsys/project.yaml"
  lock="$project_dir/.engsys/lock.yaml"
  profile=$(project_profile "$contract")
  if [ -f "$system_root/profiles/$profile.yaml" ]; then
    doctor_report ok "profile $profile exists in this system checkout"
  else
    doctor_report fail "profile is unknown in this system checkout: $profile" \
      'the project needs a system revision that declares this profile'
    failures=$((failures + 1))
  fi

  locked=$(lock_system_revision "$lock")
  if [ -z "$locked" ]; then
    doctor_report fail 'lock has no system revision' 'run: engsys upgrade --apply'
    failures=$((failures + 1))
  elif git -C "$system_root" cat-file -e "$locked^{commit}" 2>/dev/null; then
    doctor_report ok "locked system revision is available: $locked"
    if git -C "$system_root" merge-base --is-ancestor "$locked" origin/main 2>/dev/null; then
      if [ "$locked" = "$(git -C "$system_root" rev-parse origin/main 2>/dev/null)" ]; then
        doctor_report ok 'lock is at origin/main'
      else
        doctor_report warn 'a newer system revision is on origin/main' \
          "review it first: engsys upgrade --project $project_dir"
      fi
    else
      doctor_report warn 'locked revision is not on origin/main yet' \
        'push or merge it before a teammate clones this project; their engsys cannot fetch it'
    fi
  else
    doctor_report fail "locked system revision is missing locally: $locked" \
      "run: git -C $system_root fetch origin"
    failures=$((failures + 1))
  fi

  printf '\n%s\n' "$failures problem(s) to fix"
  [ "$failures" -eq 0 ] || exit 1
}

# 선언한 block 이 파싱되지 않으면 검사는 조용히 0건으로 통과한다. 들여쓰기를 잘못 쓴 계약이
# 그대로 gate 를 지나가는 것을 막기 위해, 선언했는데 내용이 없는 경우를 오류로 본다.
contract_block() {
  awk -v top="$1" -v want="$2" '
    $0 == top ":" { in_top = 1; next }
    /^[A-Za-z]/ { in_top = 0 }
    in_top && $0 == "  " want ":" { in_block = 1; next }
    in_top && /^  [a-z-]+:/ { in_block = 0 }
    in_block { print }
  ' "$3"
}

require_block_entries() {
  block_contract=$1
  block_top=$2
  block_name=$3
  block_pattern=$4
  block_hint=$5
  grep -q "^  $block_name:\$" "$block_contract" || return 0
  contract_block "$block_top" "$block_name" "$block_contract" \
    | grep -Eq "$block_pattern" \
    || die "$block_top.$block_name is declared but no entry was read; $block_hint"
}

# 검사 대상이 전송할 commit 과 같은지 단언한다. commands.verify 와 generator 는 개발 환경
# (untracked venv·node_modules)을 쓰므로 임의 commit 을 깨끗한 worktree 로 꺼내 돌릴 수 없다.
# 그래서 실행하기 전에 tree 가 그 commit 인지 확인한다.
require_tree_is_commit() {
  tree_project=$1
  tree_revision=$2
  tree_label=$3
  require_worktree "$tree_project"
  tree_commit=$(git -C "$tree_project" rev-parse --verify "$tree_revision^{commit}" 2>/dev/null) \
    || die "revision is not a commit: $tree_revision"
  tree_differs=$(git -C "$tree_project" diff --name-only "$tree_commit" -- | sed -n '1,5p')
  tree_extra=$(git -C "$tree_project" ls-files --others --exclude-standard | sed -n '1,5p')
  if [ -n "$tree_differs$tree_extra" ]; then
    printf '%s\n' "engsys: the working tree is not $tree_commit; these checks would judge other content" >&2
    [ -z "$tree_differs" ] || printf '%s\n' "$tree_differs" | sed 's/^/  changed  /' >&2
    [ -z "$tree_extra" ] || printf '%s\n' "$tree_extra" | sed 's/^/  untracked  /' >&2
    die 'commit or stash the difference, or run without --revision'
  fi
  printf '%s commit %s\n' "$tree_label" "$tree_commit"
}

check() {
  project_dir=$(pwd)
  check_revision=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --revision) require_value "$@"; check_revision=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown check option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  [ -z "$check_revision" ] || require_tree_is_commit "$project_dir" "$check_revision" Checking

  contract="$project_dir/.engsys/project.yaml"
  lock="$project_dir/.engsys/lock.yaml"
  generated_paths="$project_dir/.engsys/generated-paths.txt"
  route="$project_dir/.claude/rules/engineering-system.md"
  if [ ! -f "$contract" ]; then
    die "no Engineering System contract in $project_dir
  this branch has not adopted the standard, or the adoption lives on another branch
  adopt it:  engsys init --project $project_dir --detect --hooks
  diagnose:  engsys doctor --project $project_dir"
  fi
  [ -f "$lock" ] || die "missing .engsys/lock.yaml; run engsys init or restore the lock from Git"
  [ -f "$generated_paths" ] || die "missing .engsys/generated-paths.txt; run engsys sync"
  [ -f "$route" ] || die "missing .claude/rules/engineering-system.md"

  profile=$(project_profile "$contract")
  [ -n "$profile" ] || die "project contract has no system.profile"
  require_profile_name "$profile"
  # 계약 형식의 정본은 schemas/project.schema.json이다. 프로젝트에서는 dependency 없이 돌아야
  # 하므로 additionalProperties:false를 최상위 key 검사로 근사한다.
  unknown_key=$(top_level_keys "$contract" | grep -vxE 'system|project|commands|documentation|vcs' | sed -n '1p')
  [ -z "$unknown_key" ] || die "project contract has an unknown top-level key: $unknown_key"
  require_block_entries "$contract" documentation authoring '^      - path:' \
    'each assignment needs "      - path:" and "        type:" at that indentation'
  require_block_entries "$contract" documentation review '^      - ' \
    'each scope needs "      - " at that indentation'
  require_block_entries "$contract" documentation lifecycle '^    [a-z0-9_-]+:' \
    'each lifecycle needs "    <name>:" at that indentation'
  require_block_entries "$contract" vcs branch '^    [a-z-]+:' \
    'the branch block needs "    model:" at that indentation'
  grep -Eq '^  name:[[:space:]]*[^[:space:]]' "$contract" || die "project contract has no project.name"
  grep -Eq '^  verify:[[:space:]]*[^[:space:]]' "$contract" || die "project contract has no commands.verify"
  grep -Fq 'lock-version: 1' "$lock" || die "lock has unsupported lock-version"
  unknown_key=$(top_level_keys "$lock" | grep -vxE 'lock-version|system|profile|packages' | sed -n '1p')
  [ -z "$unknown_key" ] || die "lock has an unknown top-level key: $unknown_key"
  lock_profile=$(sed -n 's/^profile:[[:space:]]*//p' "$lock" | sed -n '1p')
  lock_profile=$(yaml_unquote "$lock_profile")
  [ "$profile" = "$lock_profile" ] || die "lock profile does not match project profile"
  grep -Eq '^  repository:[[:space:]]*[^[:space:]]' "$lock" || die "lock has no system repository"
  grep -Eq '^  revision:[[:space:]]*[^[:space:]]' "$lock" || die "lock has no system revision"
  locked_packages=$(lock_package_names "$lock")
  [ -n "$locked_packages" ] || die "lock has no packages"
  for package in $locked_packages; do
    case "$package" in ''|*[!A-Za-z0-9_-]*) die "lock has invalid package name: $package" ;; esac
    version=$(lock_package_value "$lock" "$package" version)
    revision=$(lock_package_value "$lock" "$package" revision)
    [ -n "$version" ] || die "lock package has no version: $package"
    [ -n "$revision" ] || die "lock package has no revision: $package"
  done

  expected="$generated_paths.expected.$$"
  sync_generated_paths "$project_dir" "$expected"
  if ! cmp -s "$expected" "$generated_paths"; then
    rm -f "$expected"
    die "generated-paths.txt is stale; run engsys sync"
  fi
  rm -f "$expected"

  printf '%s\n' "Engineering System adapter checks passed: $project_dir"
}

sync() {
  project_dir=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown sync option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  [ -f "$project_dir/.engsys/project.yaml" ] \
    || die "no Engineering System contract in $project_dir; run engsys init --detect first"
  mkdir -p "$project_dir/.engsys"
  sync_generated_paths "$project_dir" "$project_dir/.engsys/generated-paths.txt"
  printf '%s\n' "Synchronized generated paths: $project_dir/.engsys/generated-paths.txt"
}

verify() {
  project_dir=$(pwd)
  verify_revision=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --revision) require_value "$@"; verify_revision=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown verify option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  # commands.verify 와 generator 는 개발 환경(untracked venv·node_modules)을 쓰므로 임의 commit 을
  # 깨끗한 worktree 로 꺼내 돌릴 수 없다. 대신 검사할 tree 가 그 commit 과 같은지 먼저 단언한다.
  # 그러지 않으면 working tree 를 검사하고 다른 commit 을 통과시킨다.
  [ -z "$verify_revision" ] || require_tree_is_commit "$project_dir" "$verify_revision" Verifying
  printf '%s\n' "Engineering System revision: $(system_revision)"

  check --project "$project_dir"

  contract="$project_dir/.engsys/project.yaml"
  verify_command=$(project_verify_command "$contract")
  [ -n "$verify_command" ] || die "project contract has no commands.verify"
  printf '%s\n' "Running project verification: $verify_command"
  (cd "$project_dir" && sh -c "$verify_command")

  generated_commands=$(extract_generated_commands "$contract")
  if [ -n "$generated_commands" ]; then
    printf '%s\n' "$generated_commands" | while IFS= read -r generated_command; do
      [ -n "$generated_command" ] || continue
      printf '%s\n' "Running generated-document verification: $generated_command"
      (cd "$project_dir" && sh -c "$generated_command")
    done
  fi
  if grep -q '^vcs:' "$contract"; then
    printf '%s\n' "Running branch settings verification"
    ENGSYS_SYSTEM_ROOT="$system_root" \
      sh "$system_root/packages/vcs-gov/bin/branch-settings.sh" check-settings --project "$project_dir"
  fi

  if grep -q '^  authoring:' "$contract"; then
    printf '%s\n' "Running document structure verification"
    docs check --project "$project_dir"
  fi

  if grep -q '^  review:' "$contract"; then
    printf '%s\n' "Running editorial review verification"
    ENGSYS_SYSTEM_ROOT="$system_root" \
      sh "$system_root/packages/docs-gov/bin/review-documents.sh" check --project "$project_dir"
  fi

  printf '%s\n' "Engineering System verification passed: $project_dir"
}

upgrade() (
  project_dir=$(pwd)
  apply=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --apply) apply=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown upgrade option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  check --project "$project_dir"

  contract="$project_dir/.engsys/project.yaml"
  lock="$project_dir/.engsys/lock.yaml"
  profile=$(project_profile "$contract")
  require_profile "$profile"
  locked_packages=$(lock_package_names "$lock")
  target_packages=$(profile_packages "$profile")

  printf '%s\n' "Engineering System upgrade plan: $project_dir"
  printf '%s\n' "  system: $(lock_system_revision "$lock") -> $(system_revision)"
  printf '%s\n' "  profile: $profile"
  for package in $target_packages; do
    target_version=$(package_version "$package")
    target_revision=$(system_revision)
    locked_version=$(lock_package_value "$lock" "$package" version)
    locked_revision=$(lock_package_value "$lock" "$package" revision)
    if [ -n "$locked_version" ]; then
      printf '%s\n' "  $package: $locked_version@$locked_revision -> $target_version@$target_revision"
    else
      printf '%s\n' "  $package: added -> $target_version@$target_revision"
    fi
  done
  for package in $locked_packages; do
    if ! list_contains "$target_packages" "$package"; then
      printf '%s\n' "  $package: removed"
    fi
  done

  if [ "$apply" = false ]; then
    printf '%s\n' 'No files changed. Re-run with --apply only after reviewing this plan.'
    return
  fi

  # Keep the previous lock until the new one passes every declared check. Run verify
  # as a fresh process: testing a shell function in `if` disables its errexit behavior.
  upgrade_lock="$project_dir/.engsys/lock.yaml"
  upgrade_backup=$(mktemp "$project_dir/.engsys/lock.yaml.backup.XXXXXX")
  cp -p "$upgrade_lock" "$upgrade_backup"
  upgrade_next=
  upgrade_complete=false
  finish_upgrade() {
    upgrade_status=$?
    trap - 0 1 2 15
    if [ "$upgrade_complete" = false ]; then
      if ! mv -f "$upgrade_backup" "$upgrade_lock"; then
        printf '%s\n' "engsys: could not restore lock; backup remains at $upgrade_backup" >&2
        exit 1
      fi
      printf '%s\n' 'engsys: upgrade failed; restored the previous lock' >&2
    else
      rm -f "$upgrade_backup"
    fi
    [ -z "$upgrade_next" ] || rm -f "$upgrade_next"
    exit "$upgrade_status"
  }
  trap finish_upgrade 0
  trap 'exit 129' 1
  trap 'exit 130' 2
  trap 'exit 143' 15

  upgrade_next=$(mktemp "$project_dir/.engsys/lock.yaml.next.XXXXXX")
  cp -p "$upgrade_backup" "$upgrade_next"
  write_lock "$project_dir" "$profile" "$upgrade_next"
  mv -f "$upgrade_next" "$upgrade_lock"
  if "$system_root/bin/engsys" verify --project "$project_dir"; then
    upgrade_complete=true
  else
    exit "$?"
  fi
  printf '%s\n' "Applied Engineering System upgrade: $project_dir"
)

resolve() {
  project_dir=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown resolve option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  resolve_locked_plugin "$project_dir"
}

claude() {
  project_dir=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) break ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  command -v claude >/dev/null 2>&1 || die "Claude Code is not on PATH"
  check --project "$project_dir"
  plugin_source=$(resolve_locked_plugin "$project_dir")
  plugin_root=$(materialize_plugin_view "$project_dir" "$plugin_source")
  unset ENGSYS_SYSTEM_ROOT
  # IMPORTANT: CLAUDE_PLUGIN_ROOT·CLAUDE_PROJECT_DIR는 hook process에만 주입된다. skill이
  # Bash로 실행하는 명령은 launcher가 export한 이 변수로만 plugin view에 닿을 수 있다.
  export ENGSYS_PLUGIN_ROOT="$plugin_root"
  cd "$project_dir" || die "could not enter project directory: $project_dir"
  exec claude --plugin-dir "$plugin_root" "$@"
}

shell_quote() {
  printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"
}

shellenv() {
  bin_dir="$system_root/bin"
  printf 'export PATH=%s:"$PATH"\n' "$(shell_quote "$bin_dir")"
}

command=${1:-help}
case "$command" in
  init) shift; init "$@" ;;
  check) shift; exec_locked_revision check "$@"; check "$@" ;;
  setup) shift; setup "$@" ;;
  doctor) shift; doctor "$@" ;;
  hooks) shift; hooks "$@" ;;
  sync) shift; exec_locked_revision sync "$@"; sync "$@" ;;
  verify) shift; exec_locked_revision verify "$@"; verify "$@" ;;
  review)
    shift
    exec_locked_revision review "$@"
    ENGSYS_SYSTEM_ROOT="$system_root" sh "$system_root/packages/docs-gov/bin/review-documents.sh" "$@"
    ;;
  docs) shift; exec_locked_revision docs "$@"; docs "$@" ;;
  vcs)
    shift
    exec_locked_revision vcs "$@"
    vcs_action=${1:-help}
    case "$vcs_action" in
      check-message)
        shift
        ENGSYS_SYSTEM_ROOT="$system_root" \
          sh "$system_root/packages/vcs-gov/bin/check-commit-message.sh" "$@"
        ;;
      check-branch)
        shift
        ENGSYS_SYSTEM_ROOT="$system_root" \
          sh "$system_root/packages/vcs-gov/bin/check-branch-name.sh" "$@"
        ;;
      base-branch|check-settings|settings)
        ENGSYS_SYSTEM_ROOT="$system_root" \
          sh "$system_root/packages/vcs-gov/bin/branch-settings.sh" "$@"
        ;;
      help|-h|--help) usage ;;
      *) die "unknown vcs action: $vcs_action" ;;
    esac
    ;;
  upgrade) shift; upgrade "$@" ;;
  resolve) shift; resolve "$@" ;;
  claude) shift; claude "$@" ;;
  shellenv) shift; shellenv "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $command" ;;
esac
