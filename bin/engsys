#!/bin/sh

# Dependency-free project adapter for the Engineering System plugin.
set -eu

# git 은 hook 을 부를 때 GIT_INDEX_FILE 같은 변수를 상대 경로로 물려준다. 그대로 두면 engsys 가
# cache worktree 를 상대로 도는 git 호출까지 호출자의 index 를 집어 전 파일을 변경으로 읽고,
# 멀쩡한 cache 를 "local changes" 로 죽인다. 대상 저장소는 언제나 git -C 로 지정한다.
unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_NAMESPACE

if [ -n "${ENGSYS_SYSTEM_ROOT:-}" ]; then
  system_root=$(CDPATH= cd -- "$ENGSYS_SYSTEM_ROOT" && pwd)
else
  system_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
fi

die() {
  printf '%s\n' "engsys: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  engsys init [--detect | --verify <command>] [options]
  engsys check [--project <directory>] [--revision <commit>]
  engsys setup [--project <directory>] [--yes]
  engsys doctor [--project <directory>]
  engsys hooks <status|update> [--project <directory>] [--force] [--adopt]
  engsys sync [--project <directory>]
  engsys verify [--project <directory>] [--revision <commit>]
  engsys review <status|record|check> [options]
  engsys docs check [--project <directory>] [--path <document>]
  engsys docs new --type <type> <slug> [--project <directory>] [--path <directory>]
  engsys vcs check-message <file> [--project <directory>]
  engsys vcs check-branch [--project <directory>] [--branch <name>]
  engsys vcs <base-branch|check-settings|settings> [--project <directory>] [--branch <name>]
  engsys upgrade [--project <directory>] [--apply]
  engsys resolve [--project <directory>]
  engsys claude [--project <directory>] [claude arguments...]
  engsys shellenv

Options for init:
  --project <directory>       Target Git worktree (default: current directory)
  --detect                    Fill unset declarations by inspecting the project
  --dry-run                   Show what init would write and change nothing
  --hooks                     Write .githooks/pre-push and point core.hooksPath at it
  --name <name>               Project name (default: directory name)
  --profile <profile>         System profile (default: baseline)
  --verify <command>          Project-native verification command (required)
  --source <name=path>        Source-of-truth path; repeatable
  --policy <path>             Documentation policy path
  --architecture <path>       Current architecture document path
  --generated <path> <command>
                              Generated document output and its check command; repeatable
  --lifecycle <name> <path> <statuses>
                              Historical record path and comma-separated frozen statuses; repeatable
EOF
}

yaml_quote() {
  printf "'%s'" "$(printf %s "$1" | sed "s/'/''/g")"
}

yaml_unquote() {
  value=$1
  case "$value" in
    \'*\') value=${value#\'}; value=${value%\'}; value=$(printf %s "$value" | sed "s/''/'/g") ;;
  esac
  printf %s "$value"
}

require_value() {
  [ "$#" -ge 2 ] || die "$1 requires a value"
}

normalise_project_dir() {
  [ -d "$1" ] || die "project directory does not exist: $1"
  (CDPATH= cd -- "$1" && pwd)
}

require_worktree() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "target is not a Git worktree: $1"
}

require_profile() {
  require_profile_name "$1"
  [ -f "$system_root/profiles/$1.yaml" ] || die "unknown profile: $1"
}

require_profile_name() {
  case "$1" in
    ''|*[!A-Za-z0-9_-]*) die "invalid profile name: $1" ;;
  esac
}

require_relative_path() {
  case "$1" in
    ''|/*|..|../*|*/../*|*/..) die "path must be project-relative: $1" ;;
  esac
}

profile_packages() {
  awk '
    /^packages:$/ { in_packages = 1; next }
    /^[A-Za-z]/ { in_packages = 0 }
    in_packages && /^  - / { sub(/^  -[ \t]*/, ""); print }
  ' "$system_root/profiles/$1.yaml"
}

package_version() {
  sed -n 's/^  version:[[:space:]]*//p' "$system_root/packages/$1/package.yaml" | sed -n '1p'
}

system_revision() {
  git -C "$system_root" rev-parse HEAD 2>/dev/null || printf '%s' 'unversioned'
}

system_is_clean() {
  [ -z "$(git -C "$system_root" status --porcelain --untracked-files=no 2>/dev/null)" ]
}

cache_root() {
  if [ -n "${ENGSYS_CACHE_DIR:-}" ]; then
    printf '%s' "$ENGSYS_CACHE_DIR"
  elif [ -n "${XDG_CACHE_HOME:-}" ]; then
    printf '%s/engineering-system' "$XDG_CACHE_HOME"
  else
    printf '%s/.cache/engineering-system' "$HOME"
  fi
}

require_safe_revision() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) die "unsupported lock revision: $1" ;;
  esac
}

project_profile() {
  profile=$(sed -n 's/^  profile:[[:space:]]*//p' "$1" | sed -n '1p')
  yaml_unquote "$profile"
}

lock_package_names() {
  awk '
    /^packages:$/ { in_packages = 1; next }
    in_packages && /^  [A-Za-z0-9_-]+:$/ {
      name = $0
      sub(/^  /, "", name)
      sub(/:$/, "", name)
      print name
    }
  ' "$1"
}

lock_package_value() {
  lock=$1
  package=$2
  key=$3
  value=$(awk -v package="$package" -v key="$key" '
    $0 == "  " package ":" { in_package = 1; next }
    in_package && /^  [A-Za-z0-9_-]+:$/ { exit }
    in_package && $0 ~ "^    " key ":[[:space:]]*" {
      sub("^    " key ":[[:space:]]*", "")
      print
      exit
    }
  ' "$lock")
  yaml_unquote "$value"
}

lock_system_revision() {
  revision=$(sed -n '/^system:$/,/^profile:$/s/^  revision:[[:space:]]*//p' "$1" | sed -n '1p')
  yaml_unquote "$revision"
}

. "$system_root/lib/plugin-runtime.sh"

list_contains() {
  printf '%s\n' "$1" | grep -Fxq "$2"
}

top_level_keys() {
  sed -n 's/^\([A-Za-z][A-Za-z0-9_-]*\):.*$/\1/p' "$1"
}

# venv 의 실행 경로처럼 OS 마다 갈리는 명령만 platform 변형으로 선언한다. Git Bash 의 uname 은
# MINGW64_NT-10.0 처럼 답한다.
current_platform() {
  case "$(uname -s 2>/dev/null)" in
    Darwin) printf 'macos' ;;
    Linux) printf 'linux' ;;
    MINGW*|MSYS*|CYGWIN*|Windows_NT) printf 'windows' ;;
    *) printf 'unknown' ;;
  esac
}

contract_command() {
  command=$(sed -n "s/^  $2:[[:space:]]*//p" "$1" | sed -n '1p')
  yaml_unquote "$command"
}

# 이 platform 의 변형이 있으면 그것을, 없으면 기본 선언을 쓴다. 고르는 주체는 계약이지 사람이 아니다.
project_verify_key() {
  platform=${2:-$(current_platform)}
  for key in "verify-$platform" verify; do
    [ -z "$(contract_command "$1" "$key")" ] || { printf '%s' "$key"; return 0; }
  done
}

project_verify_command() {
  key=$(project_verify_key "$1" "${2:-}")
  [ -n "$key" ] || return 0
  contract_command "$1" "$key"
}

write_status_list() {
  statuses=$1
  old_ifs=$IFS
  IFS=,
  set -- $statuses
  IFS=$old_ifs
  [ "$#" -gt 0 ] || die "lifecycle requires at least one frozen status"

  first=true
  printf '['
  for status in "$@"; do
    [ -n "$status" ] || die "lifecycle contains an empty frozen status"
    if [ "$first" = true ]; then
      first=false
    else
      printf ', '
    fi
    yaml_quote "$status"
  done
  printf ']'
}

write_project_contract() {
  project_dir=$1
  profile=$2
  name=$3
  verify=$4
  sources=$5
  policy=$6
  architecture=$7
  generated=$8
  lifecycles=$9

  {
    printf '%s\n' 'system:'
    printf '  profile: '; yaml_quote "$profile"; printf '\n\n'
    printf '%s\n' 'project:'
    printf '  name: '; yaml_quote "$name"; printf '\n'
    if [ -n "$sources" ]; then
      printf '%s\n' '  source-of-truth:'
      printf '%s\n' "$sources" | while IFS="$(printf '\t')" read -r source_name source_path; do
        printf '    %s: ' "$source_name"; yaml_quote "$source_path"; printf '\n'
      done
    else
      printf '%s\n' '  source-of-truth: {}'
    fi
    printf '\n%s\n' 'commands:'
    printf '  verify: '; yaml_quote "$verify"; printf '\n\n'
    printf '%s\n' 'documentation:'
    if [ -n "$policy" ]; then
      printf '  policy: '; yaml_quote "$policy"; printf '\n'
    fi
    if [ -n "$architecture" ]; then
      printf '  architecture: '; yaml_quote "$architecture"; printf '\n'
    fi
    if [ -n "$generated" ]; then
      printf '%s\n' '  generated:'
      printf '%s\n' "$generated" | while IFS="$(printf '\t')" read -r output command; do
        printf '    - output: '; yaml_quote "$output"; printf '\n'
        printf '      command: '; yaml_quote "$command"; printf '\n'
      done
    else
      printf '%s\n' '  generated: []'
    fi
    if [ -n "$lifecycles" ]; then
      printf '%s\n' '  lifecycle:'
      printf '%s\n' "$lifecycles" | while IFS="$(printf '\t')" read -r lifecycle_name lifecycle_path lifecycle_statuses; do
        printf '    %s:\n' "$lifecycle_name"
        printf '      path: '; yaml_quote "$lifecycle_path"; printf '\n'
        printf '      frozen-status: '; write_status_list "$lifecycle_statuses"; printf '\n'
      done
    else
      printf '%s\n' '  lifecycle: {}'
    fi
    # authoring_assign 과 review_scopes 는 init 의 scope 에서 읽는다. 이 함수는 POSIX shell 이
    # 직접 참조할 수 있는 위치 인자를 이미 모두 쓴다.
    if [ -n "${authoring_assign:-}" ]; then
      printf '%s\n' '  authoring:'
      printf '%s\n' '    assign:'
      printf '%s\n' "$authoring_assign" | while IFS="$(printf '\t')" read -r assign_path assign_type; do
        [ -n "$assign_path" ] || continue
        printf '      - path: '; yaml_quote "$assign_path"; printf '\n'
        printf '        type: '; yaml_quote "$assign_type"; printf '\n'
      done
    fi
    if [ -n "${review_scopes:-}" ]; then
      printf '%s\n' '  review:'
      printf '%s\n' '    scopes:'
      printf '%s\n' "$review_scopes" | while IFS= read -r review_scope; do
        [ -n "$review_scope" ] || continue
        printf '      - '; yaml_quote "$review_scope"; printf '\n'
      done
    fi
    if [ -n "${vcs_model:-}" ]; then
      printf '\n%s\n' 'vcs:'
      printf '%s\n' '  branch:'
      printf '    model: '; yaml_quote "$vcs_model"; printf '\n'
      if [ -n "${vcs_roles:-}" ]; then
        printf '%s\n' '    roles:'
        printf '%s\n' "$vcs_roles" | while IFS="$(printf '\t')" read -r role_name role_branch; do
          [ -n "$role_name" ] || continue
          printf '      - role: '; yaml_quote "$role_name"; printf '\n'
          printf '        branch: '; yaml_quote "$role_branch"; printf '\n'
        done
        printf '%s\n' '    protected:'
        printf '%s\n' "$vcs_roles" | while IFS="$(printf '\t')" read -r role_name role_branch; do
          [ -n "$role_branch" ] || continue
          printf '      - '; yaml_quote "$role_branch"; printf '\n'
        done
      fi
    fi
  } >"$project_dir/.engsys/project.yaml"
}

write_lock() {
  project_dir=$1
  profile=$2
  lock_destination=${3:-"$project_dir/.engsys/lock.yaml"}
  revision=$(system_revision)
  [ "$revision" != unversioned ] \
    || die "system checkout is not a Git repository; cannot record a lock revision"
  # 검증은 working tree로 돌지만 lock은 commit만 가리킬 수 있다. 어긋남을 조용히 넘기지 않는다.
  system_is_clean || printf '%s\n' \
    "engsys: warning: system checkout has uncommitted changes; the lock records committed revision $revision" >&2

  {
    printf '%s\n' 'lock-version: 1'
    printf '%s\n' 'system:'
    printf '%s\n' '  repository: github.com/pis-o-cake/engineering-system'
    printf '  revision: '; yaml_quote "$revision"; printf '\n'
    printf 'profile: '; yaml_quote "$profile"; printf '\n'
    printf '%s\n' 'packages:'
    profile_packages "$profile" | while IFS= read -r package; do
      [ -f "$system_root/packages/$package/package.yaml" ] || die "profile references missing package: $package"
      version=$(package_version "$package")
      [ -n "$version" ] || die "package has no version: $package"
      printf '  %s:\n' "$package"
      printf '    version: '; yaml_quote "$version"; printf '\n'
      printf '    revision: '; yaml_quote "$revision"; printf '\n'
    done
  } >"$lock_destination"
}

extract_generated_paths() {
  awk -v requested=output -f "$system_root/lib/generated-documents.awk" "$1"
}

extract_generated_commands() {
  awk -v requested=command -v platform="${2:-$(current_platform)}" \
    -f "$system_root/lib/generated-documents.awk" "$1"
}

sync_generated_paths() {
  project_dir=$1
  destination=$2
  temporary="$destination.tmp.$$"
  cleanup_temporary() {
    cleanup_status=$?
    rm -f "$temporary"
    trap - 0 1 2 15
    exit "$cleanup_status"
  }
  trap cleanup_temporary 0 1 2 15
  extract_generated_paths "$project_dir/.engsys/project.yaml" >"$temporary"
  while IFS= read -r output || [ -n "$output" ]; do
    require_relative_path "$output"
  done <"$temporary"
  mv "$temporary" "$destination"
  trap - 0 1 2 15
}

# Detection fills declarations a new project would otherwise type by hand. Every value it
# writes is reported, and any explicit option wins over it.
detect_verify_command() {
  dir=$1
  if [ -f "$dir/Makefile" ]; then
    if grep -Eq '^check[[:space:]]*:' "$dir/Makefile"; then printf 'make check'; return; fi
    if grep -Eq '^test[[:space:]]*:' "$dir/Makefile"; then printf 'make test'; return; fi
  fi
  if [ -f "$dir/pyproject.toml" ]; then
    if grep -q '\[tool\.poe' "$dir/pyproject.toml"; then printf 'poe check'; return; fi
    printf 'pytest'; return
  fi
  if [ -f "$dir/package.json" ] && grep -q '"test"[[:space:]]*:' "$dir/package.json"; then
    printf 'npm test'; return
  fi
  if [ -f "$dir/gradlew" ]; then printf './gradlew check'; return; fi
  if [ -f "$dir/go.mod" ]; then printf 'go test ./...'; return; fi
  if [ -f "$dir/Cargo.toml" ]; then printf 'cargo test'; return; fi
}

# A path only gets a type assignment while it holds no authored document. Assigning a
# directory of untyped documents would fail every check from the first run.
path_has_documents() {
  target="$1/$2"
  if [ -f "$target" ]; then return 0; fi
  [ -d "$target" ] || return 1
  found=$(find "$target" -type f \( -name '*.md' -o -name '*.html' \) -print 2>/dev/null | head -1)
  [ -n "$found" ]
}

detect_declarations() {
  dir=$1
  if [ -z "$verify" ]; then
    verify=$(detect_verify_command "$dir")
    [ -z "$verify" ] || printf '%s\n' "detected verify command: $verify"
  fi
  if [ -z "$sources" ]; then
    for candidate in backend frontend infra src app server client migrations; do
      [ -d "$dir/$candidate" ] || continue
      sources="${sources}${sources:+
}$candidate$(printf '\t')$candidate/"
      printf '%s\n' "detected source-of-truth: $candidate -> $candidate/"
    done
  fi
  if [ -z "$policy" ] && [ -f "$dir/docs/documentation-policy.md" ]; then
    policy=docs/documentation-policy.md
    printf '%s\n' "detected documentation policy: $policy"
  fi
  if [ -z "$architecture" ] && [ -f "$dir/docs/architecture/README.md" ]; then
    architecture=docs/architecture/README.md
    printf '%s\n' "detected current architecture: $architecture"
  fi
  if [ -z "$lifecycles" ]; then
    if [ -d "$dir/docs/design" ]; then
      lifecycles="${lifecycles}${lifecycles:+
}design$(printf '\t')docs/design$(printf '\t')implemented"
      printf '%s\n' 'detected lifecycle: design -> docs/design'
    fi
    if [ -d "$dir/docs/adr" ]; then
      lifecycles="${lifecycles}${lifecycles:+
}adr$(printf '\t')docs/adr$(printf '\t')accepted"
      printf '%s\n' 'detected lifecycle: adr -> docs/adr'
    fi
  fi
  detect_authoring "$dir"
  detect_vcs "$dir"
}

detect_vcs() {
  dir=$1
  [ -z "$vcs_model" ] || return 0
  branches=$(git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null || true)
  production=
  development=
  for candidate in main master trunk; do
    case "
$branches" in *"
$candidate"*) production=$candidate; break ;; esac
  done
  for candidate in develop dev development; do
    case "
$branches" in *"
$candidate"*) development=$candidate; break ;; esac
  done
  [ -n "$production" ] || return 0
  if [ -n "$development" ]; then
    vcs_model=env-branch
    vcs_roles="development$(printf '\t')$development
production$(printf '\t')$production"
    printf '%s\n' "detected branch model: env-branch ($development -> $production)"
  else
    vcs_model=single-main
    vcs_roles="production$(printf '\t')$production"
    printf '%s\n' "detected branch model: single-main ($production)"
  fi
}

detect_authoring() {
  dir=$1
  [ -z "$authoring_assign" ] || return 0
  pending=
  for pair in 'README.md guide' 'docs/adr decision-record' 'docs/architecture architecture' \
              'docs/design design-proposal'; do
    candidate=${pair%% *}
    type_name=${pair##* }
    if path_has_documents "$dir" "$candidate"; then
      pending="${pending}${pending:+, }$candidate"
      continue
    fi
    [ -e "$dir/$candidate" ] || [ "$candidate" = README.md ] || continue
    authoring_assign="${authoring_assign}${authoring_assign:+
}$candidate$(printf '\t')$type_name"
    printf '%s\n' "assigned document type: $candidate -> $type_name"
  done
  [ -z "$pending" ] || printf '%s\n' \
    "not assigned because documents already exist there: $pending
  declare a type on each document, then add it to documentation.authoring.assign"
}

write_project_hook() {
  dir=$1
  mkdir -p "$dir/.githooks"
  for hook_name in commit-msg pre-push; do
    source_hook="$system_root/templates/project/.githooks/$hook_name"
    [ -f "$source_hook" ] || die "hook template is missing: $source_hook"
    if [ -e "$dir/.githooks/$hook_name" ]; then
      printf 'kept the existing .githooks/%s\n' "$hook_name"
    else
      cp "$source_hook" "$dir/.githooks/$hook_name"
      chmod +x "$dir/.githooks/$hook_name"
      hook_seed_hash=$(git hash-object -- "$source_hook")
      record_hook_baseline "$dir" "$hook_name" "$hook_seed_hash" "$hook_seed_hash"
      printf 'wrote .githooks/%s\n' "$hook_name"
    fi
  done
  current=$(git -C "$dir" config --get core.hooksPath 2>/dev/null || true)
  if [ -z "$current" ]; then
    git -C "$dir" config core.hooksPath .githooks
    printf '%s\n' 'registered core.hooksPath .githooks'
  elif [ "$current" = .githooks ]; then
    printf '%s\n' 'core.hooksPath is already .githooks'
  else
    printf '%s\n' "left core.hooksPath as $current; run the gate from there or change it yourself"
  fi
}

init() {
  project_dir=$(pwd)
  profile=baseline
  name=
  verify=
  sources=
  policy=
  architecture=
  generated=
  lifecycles=
  authoring_assign=
  review_scopes=
  vcs_model=
  vcs_roles=
  detect=false
  hooks=false
  dry_run=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --detect) detect=true; shift ;;
      --dry-run) dry_run=true; shift ;;
      --hooks) hooks=true; shift ;;
      --profile) require_value "$@"; profile=$2; shift 2 ;;
      --name) require_value "$@"; name=$2; shift 2 ;;
      --verify) require_value "$@"; verify=$2; shift 2 ;;
      --source)
        require_value "$@"
        source_name=${2%%=*}
        source_path=${2#*=}
        [ "$source_name" != "$source_path" ] && [ -n "$source_name" ] && [ -n "$source_path" ] \
          || die "--source must be name=path"
        case "$source_name" in *[!A-Za-z0-9_-]*) die "invalid source name: $source_name" ;; esac
        require_relative_path "$source_path"
        sources="${sources}${sources:+
}$source_name$(printf '\t')$source_path"
        shift 2
        ;;
      --policy) require_value "$@"; policy=$2; require_relative_path "$policy"; shift 2 ;;
      --architecture) require_value "$@"; architecture=$2; require_relative_path "$architecture"; shift 2 ;;
      --generated)
        [ "$#" -ge 3 ] || die "--generated requires an output path and command"
        require_relative_path "$2"
        [ -n "$3" ] || die "generated document command must not be empty"
        generated="${generated}${generated:+
}$2$(printf '\t')$3"
        shift 3
        ;;
      --lifecycle)
        [ "$#" -ge 4 ] || die "--lifecycle requires a name, path, and frozen statuses"
        case "$2" in ''|*[!A-Za-z0-9_-]*) die "invalid lifecycle name: $2" ;; esac
        require_relative_path "$3"
        [ -n "$4" ] || die "lifecycle requires frozen statuses"
        lifecycles="${lifecycles}${lifecycles:+
}$2$(printf '\t')$3$(printf '\t')$4"
        shift 4
        ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown init option: $1" ;;
    esac
  done

  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  require_profile "$profile"

  if [ -e "$project_dir/.engsys/project.yaml" ] || [ -e "$project_dir/.engsys/lock.yaml" ]; then
    die "project contract already exists; inspect it and use engsys sync or upgrade instead"
  fi

  [ "$detect" = false ] || detect_declarations "$project_dir"
  [ -n "$verify" ] \
    || die "--verify is required; detection found no native verification command in $project_dir"
  [ -n "$name" ] || name=$(basename "$project_dir")

  if [ "$dry_run" = true ]; then
    dry_root=$(mktemp -d)
    mkdir -p "$dry_root/.engsys"
    write_project_contract "$dry_root" "$profile" "$name" "$verify" "$sources" "$policy" \
      "$architecture" "$generated" "$lifecycles"
    printf '\n%s\n' '--- .engsys/project.yaml (미리보기, 쓰지 않음) ---'
    cat "$dry_root/.engsys/project.yaml"
    printf '%s\n' '--- 끝 ---'
    [ "$hooks" = false ] || printf '\n%s\n' \
      '--hooks: .githooks/commit-msg 와 .githooks/pre-push 를 심고 core.hooksPath 를 설정한다'
    rm -rf "$dry_root"
    printf '\n%s\n' "Nothing was written. Re-run without --dry-run to apply."
    return
  fi

  mkdir -p "$project_dir/.engsys" "$project_dir/.claude/rules"
  write_project_contract "$project_dir" "$profile" "$name" "$verify" "$sources" "$policy" "$architecture" "$generated" "$lifecycles"
  write_lock "$project_dir" "$profile"
  sync_generated_paths "$project_dir" "$project_dir/.engsys/generated-paths.txt"

  route="$project_dir/.claude/rules/engineering-system.md"
  if [ ! -e "$route" ]; then
    cp "$system_root/templates/project/.claude/rules/engineering-system.md" "$route"
  fi

  [ "$hooks" = false ] || write_project_hook "$project_dir"

  printf '%s\n' "Initialized Engineering System contract in $project_dir"
}

docs() {
  project_dir=$(pwd)
  docs_action=${1:-check}
  action=$docs_action
  case "$action" in
    check|new) shift ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown docs action: $action" ;;
  esac
  if [ "$docs_action" = new ]; then
    ENGSYS_SYSTEM_ROOT="$system_root" \
      sh "$system_root/packages/docs-gov/bin/new-document.sh" "$@"
    return
  fi
  docs_path=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --path) require_value "$@"; docs_path=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown docs option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  set -- --project "$project_dir"
  [ -z "$docs_path" ] || set -- "$@" --path "$docs_path"
  ENGSYS_SYSTEM_ROOT="$system_root" \
    sh "$system_root/packages/docs-gov/bin/check-structure.sh" "$@"
}

# 프로젝트가 고정한 revision 으로 실행을 넘긴다. PATH 의 engsys 는 실행기이고, 판정하는 코드는
# 언제나 그 프로젝트의 lock 이 가리키는 release 에서 온다. 그러지 않으면 같은 프로젝트를 검사한
# 결과가 개발자마다 달라진다.
project_from_arguments() {
  argument_project=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project)
        if [ "$#" -ge 2 ]; then argument_project=$2; shift 2; else shift; fi
        ;;
      *) shift ;;
    esac
  done
  printf '%s' "$argument_project"
}

exec_locked_revision() {
  locked_command=$1
  shift
  # 재귀 방지, 개발용 탈출구, 그리고 이 레포 자신은 자기 working tree 로 돈다.
  [ -z "${ENGSYS_PINNED:-}" ] || return 0
  [ -z "${ENGSYS_USE_CHECKOUT:-}" ] || return 0

  locked_project=$(project_from_arguments "$@")
  [ -d "$locked_project" ] || return 0
  locked_project=$(CDPATH= cd -- "$locked_project" && pwd -P)
  [ "$locked_project" != "$system_root" ] || return 0

  locked_file="$locked_project/.engsys/lock.yaml"
  [ -f "$locked_file" ] || return 0
  locked_revision=$(lock_system_revision "$locked_file")
  [ -n "$locked_revision" ] || return 0
  # 같은 commit 이더라도 미커밋 수정은 잠긴 표준이 아니다.
  if [ "$locked_revision" = "$(system_revision)" ] && system_is_clean; then
    return 0
  fi

  if ! locked_root=$(resolve_locked_plugin "$locked_project"); then
    die "locked revision $locked_revision could not be prepared; fetch it or repair the cache before retrying"
  fi
  [ -x "$locked_root/bin/engsys" ] \
    || die "locked revision $locked_revision has no executable bin/engsys"
  ENGSYS_PINNED=1 exec "$locked_root/bin/engsys" "$locked_command" "$@"
}

# 프로젝트가 복사한 hook 은 그 프로젝트가 소유한다. 표준이 덮어쓰지 않으므로 사본이 template 과
# 언제 갈라졌는지 알 방법이 필요하다. 기록은 두 해시다 — 사본이 근거한 template, 그리고 기록
# 시점의 사본. 둘을 함께 두어야 설치 직후와 프로젝트가 고친 뒤 유지하기로 한 것을 구분한다.
. "$system_root/lib/adoption.sh"

contract_block() {
  awk -v top="$1" -v want="$2" '
    $0 == top ":" { in_top = 1; next }
    /^[A-Za-z]/ { in_top = 0 }
    in_top && $0 == "  " want ":" { in_block = 1; next }
    in_top && /^  [a-z-]+:/ { in_block = 0 }
    in_block { print }
  ' "$3"
}

require_block_entries() {
  block_contract=$1
  block_top=$2
  block_name=$3
  block_pattern=$4
  block_hint=$5
  grep -q "^  $block_name:\$" "$block_contract" || return 0
  contract_block "$block_top" "$block_name" "$block_contract" \
    | grep -Eq "$block_pattern" \
    || die "$block_top.$block_name is declared but no entry was read; $block_hint"
}

# 검사 대상이 전송할 commit 과 같은지 단언한다. commands.verify 와 generator 는 개발 환경
# (untracked venv·node_modules)을 쓰므로 임의 commit 을 깨끗한 worktree 로 꺼내 돌릴 수 없다.
# 그래서 실행하기 전에 tree 가 그 commit 인지 확인한다.
require_tree_is_commit() {
  tree_project=$1
  tree_revision=$2
  tree_label=$3
  require_worktree "$tree_project"
  tree_commit=$(git -C "$tree_project" rev-parse --verify "$tree_revision^{commit}" 2>/dev/null) \
    || die "revision is not a commit: $tree_revision"
  tree_differs=$(git -C "$tree_project" diff --name-only "$tree_commit" -- | sed -n '1,5p')
  tree_extra=$(git -C "$tree_project" ls-files --others --exclude-standard | sed -n '1,5p')
  if [ -n "$tree_differs$tree_extra" ]; then
    printf '%s\n' "engsys: the working tree is not $tree_commit; these checks would judge other content" >&2
    [ -z "$tree_differs" ] || printf '%s\n' "$tree_differs" | sed 's/^/  changed  /' >&2
    [ -z "$tree_extra" ] || printf '%s\n' "$tree_extra" | sed 's/^/  untracked  /' >&2
    die 'commit or stash the difference, or run without --revision'
  fi
  printf '%s commit %s\n' "$tree_label" "$tree_commit"
}

# CRLF 로 checkout 된 계약은 값 끝에 CR 을 달고 온다. 그 상태의 오류는 원인을 가리키지 않으므로
# ("invalid profile name: 'baseline'") 먼저 잡아서 무엇을 해야 하는지 말한다.
require_unix_line_endings() {
  [ -f "$1" ] || return 0
  # CR 을 지운 결과가 원본과 같으면 CR 이 없었다는 뜻이다. grep 에 CR 을 넘기는 방법은 shell 마다
  # 다르게 동작해 쓸 수 없다.
  tr -d '\r' <"$1" | cmp -s - "$1" && return 0
  die "$1 has CRLF line endings; the POSIX sh parsers read the carriage return as part of a value
  편집기에서 위 파일의 줄바꿈을 LF 로 바꾸고 저장한 뒤 다시 실행한다.
  파일 내용은 유지하고 줄바꿈만 변환한다. .gitattributes 적용 여부도 확인한다."
}

check() {
  project_dir=$(pwd)
  check_revision=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --revision) require_value "$@"; check_revision=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown check option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  [ -z "$check_revision" ] || require_tree_is_commit "$project_dir" "$check_revision" Checking

  contract="$project_dir/.engsys/project.yaml"
  lock="$project_dir/.engsys/lock.yaml"
  generated_paths="$project_dir/.engsys/generated-paths.txt"
  route="$project_dir/.claude/rules/engineering-system.md"
  require_unix_line_endings "$contract" "$project_dir"
  require_unix_line_endings "$lock" "$project_dir"
  if [ ! -f "$contract" ]; then
    die "no Engineering System contract in $project_dir
  this branch has not adopted the standard, or the adoption lives on another branch
  adopt it:  engsys init --project $project_dir --detect --hooks
  diagnose:  engsys doctor --project $project_dir"
  fi
  [ -f "$lock" ] || die "missing .engsys/lock.yaml; run engsys init or restore the lock from Git"
  [ -f "$generated_paths" ] || die "missing .engsys/generated-paths.txt; run engsys sync"
  [ -f "$route" ] || die "missing .claude/rules/engineering-system.md"

  profile=$(project_profile "$contract")
  [ -n "$profile" ] || die "project contract has no system.profile"
  require_profile_name "$profile"
  # 계약 형식의 정본은 schemas/project.schema.json이다. 프로젝트에서는 dependency 없이 돌아야
  # 하므로 additionalProperties:false를 최상위 key 검사로 근사한다.
  unknown_key=$(top_level_keys "$contract" | grep -vxE 'system|project|commands|documentation|vcs' | sed -n '1p')
  [ -z "$unknown_key" ] || die "project contract has an unknown top-level key: $unknown_key"
  require_block_entries "$contract" documentation authoring '^      - path:' \
    'each assignment needs "      - path:" and "        type:" at that indentation'
  require_block_entries "$contract" documentation review '^      - ' \
    'each scope needs "      - " at that indentation'
  require_block_entries "$contract" documentation lifecycle '^    [a-z0-9_-]+:' \
    'each lifecycle needs "    <name>:" at that indentation'
  require_block_entries "$contract" vcs branch '^    [a-z-]+:' \
    'the branch block needs "    model:" at that indentation'
  grep -Eq '^  name:[[:space:]]*[^[:space:]]' "$contract" || die "project contract has no project.name"
  grep -Eq '^  verify:[[:space:]]*[^[:space:]]' "$contract" || die "project contract has no commands.verify"
  # 오타 난 변형은 아무 platform 에서도 실행되지 않는다. 조용히 무시하면 검사하지 않은 것을 통과시킨다.
  unknown_key=$(sed -n '/^commands:/,/^[A-Za-z]/p' "$contract" \
    | sed -n 's/^  \([A-Za-z0-9_-]*\):.*$/\1/p' \
    | grep -vxE 'verify|verify-(macos|linux|windows)' | sed -n '1p')
  [ -z "$unknown_key" ] || die "project contract has an unknown commands key: $unknown_key"
  grep -Fq 'lock-version: 1' "$lock" || die "lock has unsupported lock-version"
  unknown_key=$(top_level_keys "$lock" | grep -vxE 'lock-version|system|profile|packages' | sed -n '1p')
  [ -z "$unknown_key" ] || die "lock has an unknown top-level key: $unknown_key"
  lock_profile=$(sed -n 's/^profile:[[:space:]]*//p' "$lock" | sed -n '1p')
  lock_profile=$(yaml_unquote "$lock_profile")
  [ "$profile" = "$lock_profile" ] || die "lock profile does not match project profile"
  grep -Eq '^  repository:[[:space:]]*[^[:space:]]' "$lock" || die "lock has no system repository"
  grep -Eq '^  revision:[[:space:]]*[^[:space:]]' "$lock" || die "lock has no system revision"
  locked_packages=$(lock_package_names "$lock")
  [ -n "$locked_packages" ] || die "lock has no packages"
  for package in $locked_packages; do
    case "$package" in ''|*[!A-Za-z0-9_-]*) die "lock has invalid package name: $package" ;; esac
    version=$(lock_package_value "$lock" "$package" version)
    revision=$(lock_package_value "$lock" "$package" revision)
    [ -n "$version" ] || die "lock package has no version: $package"
    [ -n "$revision" ] || die "lock package has no revision: $package"
  done

  expected="$generated_paths.expected.$$"
  sync_generated_paths "$project_dir" "$expected"
  if ! cmp -s "$expected" "$generated_paths"; then
    rm -f "$expected"
    die "generated-paths.txt is stale; run engsys sync"
  fi
  rm -f "$expected"

  printf '%s\n' "Engineering System adapter checks passed: $project_dir"
}

sync() {
  project_dir=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown sync option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  [ -f "$project_dir/.engsys/project.yaml" ] \
    || die "no Engineering System contract in $project_dir; run engsys init --detect first"
  mkdir -p "$project_dir/.engsys"
  sync_generated_paths "$project_dir" "$project_dir/.engsys/generated-paths.txt"
  printf '%s\n' "Synchronized generated paths: $project_dir/.engsys/generated-paths.txt"
}

verify() {
  project_dir=$(pwd)
  verify_revision=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --revision) require_value "$@"; verify_revision=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown verify option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  # commands.verify 와 generator 는 개발 환경(untracked venv·node_modules)을 쓰므로 임의 commit 을
  # 깨끗한 worktree 로 꺼내 돌릴 수 없다. 대신 검사할 tree 가 그 commit 과 같은지 먼저 단언한다.
  # 그러지 않으면 working tree 를 검사하고 다른 commit 을 통과시킨다.
  [ -z "$verify_revision" ] || require_tree_is_commit "$project_dir" "$verify_revision" Verifying
  printf '%s\n' "Engineering System revision: $(system_revision)"

  check --project "$project_dir"

  contract="$project_dir/.engsys/project.yaml"
  verify_platform=$(current_platform)
  verify_key=$(project_verify_key "$contract" "$verify_platform")
  [ -n "$verify_key" ] || die "project contract has no commands.verify"
  verify_command=$(contract_command "$contract" "$verify_key")
  printf '%s\n' "Running project verification (commands.$verify_key): $verify_command"
  (cd "$project_dir" && sh -c "$verify_command")

  generated_commands=$(extract_generated_commands "$contract" "$verify_platform")
  if [ -n "$generated_commands" ]; then
    printf '%s\n' "$generated_commands" | while IFS= read -r generated_command; do
      [ -n "$generated_command" ] || continue
      printf '%s\n' "Running generated-document verification: $generated_command"
      (cd "$project_dir" && sh -c "$generated_command")
    done
  fi
  if grep -q '^vcs:' "$contract"; then
    printf '%s\n' "Running branch settings verification"
    ENGSYS_SYSTEM_ROOT="$system_root" \
      sh "$system_root/packages/vcs-gov/bin/branch-settings.sh" check-settings --project "$project_dir"
  fi

  if grep -q '^  authoring:' "$contract"; then
    printf '%s\n' "Running document structure verification"
    docs check --project "$project_dir"
  fi

  if grep -q '^  review:' "$contract"; then
    printf '%s\n' "Running editorial review verification"
    ENGSYS_SYSTEM_ROOT="$system_root" \
      sh "$system_root/packages/docs-gov/bin/review-documents.sh" check --project "$project_dir"
  fi

  printf '%s\n' "Engineering System verification passed: $project_dir"
}

upgrade() (
  project_dir=$(pwd)
  apply=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      --apply) apply=true; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown upgrade option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  check --project "$project_dir"

  contract="$project_dir/.engsys/project.yaml"
  lock="$project_dir/.engsys/lock.yaml"
  profile=$(project_profile "$contract")
  require_profile "$profile"
  locked_packages=$(lock_package_names "$lock")
  target_packages=$(profile_packages "$profile")

  printf '%s\n' "Engineering System upgrade plan: $project_dir"
  printf '%s\n' "  system: $(lock_system_revision "$lock") -> $(system_revision)"
  printf '%s\n' "  profile: $profile"
  for package in $target_packages; do
    target_version=$(package_version "$package")
    target_revision=$(system_revision)
    locked_version=$(lock_package_value "$lock" "$package" version)
    locked_revision=$(lock_package_value "$lock" "$package" revision)
    if [ -n "$locked_version" ]; then
      printf '%s\n' "  $package: $locked_version@$locked_revision -> $target_version@$target_revision"
    else
      printf '%s\n' "  $package: added -> $target_version@$target_revision"
    fi
  done
  for package in $locked_packages; do
    if ! list_contains "$target_packages" "$package"; then
      printf '%s\n' "  $package: removed"
    fi
  done

  if [ "$apply" = false ]; then
    printf '%s\n' 'No files changed. Re-run with --apply only after reviewing this plan.'
    return
  fi

  # Keep the previous lock until the new one passes every declared check. Run verify
  # as a fresh process: testing a shell function in `if` disables its errexit behavior.
  upgrade_lock="$project_dir/.engsys/lock.yaml"
  upgrade_backup=$(mktemp "$project_dir/.engsys/lock.yaml.backup.XXXXXX")
  cp -p "$upgrade_lock" "$upgrade_backup"
  upgrade_next=
  upgrade_complete=false
  finish_upgrade() {
    upgrade_status=$?
    trap - 0 1 2 15
    if [ "$upgrade_complete" = false ]; then
      if ! mv -f "$upgrade_backup" "$upgrade_lock"; then
        printf '%s\n' "engsys: could not restore lock; backup remains at $upgrade_backup" >&2
        exit 1
      fi
      printf '%s\n' 'engsys: upgrade failed; restored the previous lock' >&2
    else
      rm -f "$upgrade_backup"
    fi
    [ -z "$upgrade_next" ] || rm -f "$upgrade_next"
    exit "$upgrade_status"
  }
  trap finish_upgrade 0
  trap 'exit 129' 1
  trap 'exit 130' 2
  trap 'exit 143' 15

  upgrade_next=$(mktemp "$project_dir/.engsys/lock.yaml.next.XXXXXX")
  cp -p "$upgrade_backup" "$upgrade_next"
  write_lock "$project_dir" "$profile" "$upgrade_next"
  mv -f "$upgrade_next" "$upgrade_lock"
  if "$system_root/bin/engsys" verify --project "$project_dir"; then
    upgrade_complete=true
  else
    exit "$?"
  fi
  printf '%s\n' "Applied Engineering System upgrade: $project_dir"
)

resolve() {
  project_dir=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown resolve option: $1" ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  resolve_locked_plugin "$project_dir"
}

claude() {
  project_dir=$(pwd)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --project) require_value "$@"; project_dir=$2; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) break ;;
    esac
  done
  project_dir=$(normalise_project_dir "$project_dir")
  require_worktree "$project_dir"
  command -v claude >/dev/null 2>&1 || die "Claude Code is not on PATH"
  check --project "$project_dir"
  plugin_source=$(resolve_locked_plugin "$project_dir")
  plugin_root=$(materialize_plugin_view "$project_dir" "$plugin_source")
  unset ENGSYS_SYSTEM_ROOT
  # IMPORTANT: CLAUDE_PLUGIN_ROOT·CLAUDE_PROJECT_DIR는 hook process에만 주입된다. skill이
  # Bash로 실행하는 명령은 launcher가 export한 이 변수로만 plugin view에 닿을 수 있다.
  export ENGSYS_PLUGIN_ROOT="$plugin_root"
  cd "$project_dir" || die "could not enter project directory: $project_dir"
  exec claude --plugin-dir "$plugin_root" "$@"
}

shell_quote() {
  printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"
}

shellenv() {
  bin_dir="$system_root/bin"
  printf 'export PATH=%s:"$PATH"\n' "$(shell_quote "$bin_dir")"
}

command=${1:-help}
case "$command" in
  init) shift; init "$@" ;;
  check) shift; exec_locked_revision check "$@"; check "$@" ;;
  setup) shift; setup "$@" ;;
  doctor) shift; doctor "$@" ;;
  hooks) shift; hooks "$@" ;;
  sync) shift; exec_locked_revision sync "$@"; sync "$@" ;;
  verify) shift; exec_locked_revision verify "$@"; verify "$@" ;;
  review)
    shift
    exec_locked_revision review "$@"
    ENGSYS_SYSTEM_ROOT="$system_root" sh "$system_root/packages/docs-gov/bin/review-documents.sh" "$@"
    ;;
  docs) shift; exec_locked_revision docs "$@"; docs "$@" ;;
  vcs)
    shift
    exec_locked_revision vcs "$@"
    vcs_action=${1:-help}
    case "$vcs_action" in
      check-message)
        shift
        ENGSYS_SYSTEM_ROOT="$system_root" \
          sh "$system_root/packages/vcs-gov/bin/check-commit-message.sh" "$@"
        ;;
      check-branch)
        shift
        ENGSYS_SYSTEM_ROOT="$system_root" \
          sh "$system_root/packages/vcs-gov/bin/check-branch-name.sh" "$@"
        ;;
      base-branch|check-settings|settings)
        ENGSYS_SYSTEM_ROOT="$system_root" \
          sh "$system_root/packages/vcs-gov/bin/branch-settings.sh" "$@"
        ;;
      help|-h|--help) usage ;;
      *) die "unknown vcs action: $vcs_action" ;;
    esac
    ;;
  upgrade) shift; upgrade "$@" ;;
  resolve) shift; resolve "$@" ;;
  claude) shift; claude "$@" ;;
  shellenv) shift; shellenv "$@" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $command" ;;
esac
