{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pis-o-cake/engineering-system/schemas/project.schema.json",
  "title": "Engineering System project contract",
  "type": "object",
  "required": ["system", "project", "commands"],
  "additionalProperties": false,
  "properties": {
    "system": {
      "type": "object",
      "required": ["profile"],
      "additionalProperties": false,
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "package-config": {"type": "object"}
      }
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source-of-truth": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {"type": "string"},
        "architecture": {"type": "string"},
        "generated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["output", "command"],
            "additionalProperties": false,
            "properties": {
              "output": {"type": "string", "minLength": 1},
              "command": {"type": "string", "minLength": 1}
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path", "frozen-status"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "frozen-status": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
