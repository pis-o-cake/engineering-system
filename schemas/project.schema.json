{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pis-o-cake/engineering-system/schemas/project.schema.json",
  "title": "Engineering System project contract",
  "type": "object",
  "required": ["system", "project", "commands"],
  "additionalProperties": false,
  "properties": {
    "system": {
      "type": "object",
      "required": ["profile"],
      "additionalProperties": false,
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "package-config": {"type": "object"}
      }
    },
    "project": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "source-of-truth": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "commands": {
      "type": "object",
      "required": ["verify"],
      "additionalProperties": false,
      "properties": {
        "verify": {"type": "string", "minLength": 1},
        "verify-macos": {"type": "string", "minLength": 1},
        "verify-linux": {"type": "string", "minLength": 1},
        "verify-windows": {"type": "string", "minLength": 1}
      }
    },
    "vcs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "subject-language": {"type": "string", "minLength": 1},
            "subject-ending": {"type": "string", "enum": ["noun", "imperative"]},
            "scopes": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["role", "branch"],
                "additionalProperties": false,
                "properties": {
                  "role": {"type": "string", "minLength": 1},
                  "branch": {"type": "string", "minLength": 1}
                }
              }
            },
            "prefixes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "feature": {"type": "string", "minLength": 1},
                "fix": {"type": "string", "minLength": 1},
                "hotfix": {"type": "string", "minLength": 1}
              }
            },
            "protected": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "naming": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "merge-request": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {"type": "string"},
        "architecture": {"type": "string"},
        "generated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["output", "command"],
            "additionalProperties": false,
            "properties": {
              "output": {"type": "string", "minLength": 1},
              "command": {"type": "string", "minLength": 1},
              "command-macos": {"type": "string", "minLength": 1},
              "command-linux": {"type": "string", "minLength": 1},
              "command-windows": {"type": "string", "minLength": 1}
            }
          }
        },
        "authoring": {
          "type": "object",
          "required": ["assign"],
          "additionalProperties": false,
          "properties": {
            "assign": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path", "type"],
                "additionalProperties": false,
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "type": {"type": "string", "minLength": 1}
                }
              }
            },
            "deferred": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "exempt": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "review": {
          "type": "object",
          "required": ["scopes"],
          "additionalProperties": false,
          "properties": {
            "scopes": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path", "frozen-status"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "frozen-status": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
