{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pis-o-cake/engineering-system/schemas/lock.schema.json",
  "title": "Engineering System resolved lock",
  "type": "object",
  "required": ["lock-version", "system", "profile", "packages"],
  "additionalProperties": false,
  "properties": {
    "lock-version": {"const": 1},
    "system": {
      "type": "object",
      "required": ["repository", "revision"],
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "profile": {"type": "string", "minLength": 1},
    "packages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["version", "revision"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
